@model AdminDashboardViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewBag.Title = "Dashboard";
}
<section class="admin-card">
    <h1>Assalamualaikum, @Model.User.DisplayName</h1>
    <p class="admin-muted">
        Signed in as @Model.User.Email
        @if (Model.User.RoleNames.Count > 0)
        {
            <text>&middot; @string.Join(", ", Model.User.RoleNames)</text>
        }
    </p>
</section>

@if (Model.NewAdmissionInquiries.HasValue)
{
    <section class="admin-stats" aria-label="New form submissions">
        <a class="admin-stat" href="/admin/inquiries?status=new">
            <p class="admin-stat-value">@Model.NewAdmissionInquiries.Value.ToString("N0")</p>
            <p class="admin-stat-label">New admission inquiries</p>
        </a>
        <a class="admin-stat" href="/admin/messages?status=new">
            <p class="admin-stat-value">@Model.NewContactMessages.Value.ToString("N0")</p>
            <p class="admin-stat-label">New messages</p>
        </a>
    </section>
}

@if (Model.BookToDo != null)
{
    var td = Model.BookToDo;
<section class="admin-card" aria-labelledby="todo-h">
    <h2 id="todo-h">Books: work to do</h2>
    <div class="admin-todo">
        <a class="@(td.NewOrders > 0 ? "has-work" : null)" href="/admin/books/orders?status=new"><strong>@td.NewOrders</strong>New orders</a>
        <a class="@(td.PaymentsToCheck > 0 ? "has-work" : null)" href="/admin/books/orders?payment=tocheck"><strong>@td.PaymentsToCheck</strong>Payments to check</a>
        <a class="@(td.RefundsPending > 0 ? "has-work" : null)" href="/admin/books/customer-accounts"><strong>@td.RefundsPending</strong>Refunds to pay back</a>
        <a class="@(td.ReturnRequests + td.ReturnsToReceive > 0 ? "has-work" : null)" href="/admin/books/return-requests"><strong>@(td.ReturnRequests + td.ReturnsToReceive)</strong>Return requests</a>
        <a class="@(td.MessagesToSend > 0 ? "has-work" : null)" href="/admin/books/messages"><strong>@td.MessagesToSend</strong>Messages to send</a>
        <a class="@(td.OverdueCustomers > 0 ? "has-work" : null)" href="/admin/books/reports?kind=aging"><strong>@td.OverdueCustomers</strong>Customers overdue</a>
    </div>
</section>
}
@if (Model.Books != null)
{
    <section class="admin-stats" aria-label="Book orders">
        <a class="admin-stat@(Model.Books.NewOrders > 0 ? " admin-stat--new" : "")" href="/admin/books/orders?status=new">
            <p class="admin-stat-value">@Model.Books.NewOrders.ToString("N0")</p>
            <p class="admin-stat-label">New book orders@(Model.Books.LastDay > 0 ? " (" + Model.Books.LastDay + " in the last 24 hours)" : "")</p>
        </a>
        <a class="admin-stat@(Model.Books.PaymentsToCheck > 0 ? " admin-stat--new" : "")" href="/admin/books/orders?payment=tocheck">
            <p class="admin-stat-value">@Model.Books.PaymentsToCheck.ToString("N0")</p>
            <p class="admin-stat-label">Book payments sent by customers, to check</p>
        </a>
        <a class="admin-stat" href="/admin/books/orders?payment=unpaid">
            <p class="admin-stat-value">@Model.Books.UnpaidOrders.ToString("N0")</p>
            <p class="admin-stat-label">Book orders not fully paid</p>
        </a>
    </section>
}

<section class="admin-card">
    <h2>Quick links</h2>
    <ul class="admin-quick-links">
        @if (Model.User.Can("inquiries.view")) { <li><a href="/admin/inquiries">Admission inquiries</a></li><li><a href="/admin/messages">Messages</a></li> }
        @if (Model.User.Can("franchise.view")) { <li><a href="/admin/franchise">Franchise applications</a></li> }
        @if (Model.User.Can("pages.view")) { <li><a href="/admin/pages">Pages</a></li> }
        @if (Model.User.Can("branches.view")) { <li><a href="/admin/campuses">Campuses</a></li> }
        <li><a href="/" target="_blank" rel="noopener">View the website</a></li>
    </ul>
</section>
