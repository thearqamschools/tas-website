@model BookCustomer
@using TheArqamSchools.Web.Helpers
@* Books menu (owner's notes 54-62, 27 November 2026): New order, My orders, Payments, More. On phones it is a tab bar
   fixed at the bottom of the screen, near the thumb; on computers it is one row at the top. The customer's details
   are on the More page. ViewBag.Title is the page's own small heading. *@
@{
    var path = (Request.Path ?? "").TrimEnd('/').ToLowerInvariant();
    var tab = path == "/books/order" || (path.StartsWith("/books/orders/") && path.EndsWith("/edit")) ? "order"
            : path.StartsWith("/books/orders") ? "orders"
            : path == "/books/payments" ? "payments"
            : "more";
    Func<string, string, string, string, IHtmlString> item = (key, href, icon, text) => new HtmlString(
        "<a class=\"books-tab" + (tab == key ? " is-current" : "") + "\" href=\"" + href + "\"" + (tab == key ? " aria-current=\"page\"" : "") + ">"
        + Icons.Svg(icon, 22).ToHtmlString() + "<span>" + HttpUtility.HtmlEncode(text) + "</span></a>");
}
<nav class="books-tabs" aria-label="Books">
    @item("order", "/books/order", "book-open", "New order")
    @item("orders", "/books/orders", "clipboard-check", "My orders")
    @item("payments", "/books/payments", "wallet", "Payments")
    @item("more", "/books/more", "menu", "More")
</nav>
