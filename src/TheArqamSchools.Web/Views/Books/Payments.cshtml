@using TheArqamSchools.Web.Helpers
@{
    // Payments (owner's note, 27 November 2026): one simple screen. "Still to pay" with Pay now (bank or cash, receipt,
    // no amount typed), then the recent entries of the statement in one list, newest first, and the full statement as PDF.
    var customer = ViewBag.Customer as BookCustomer;
    var subs = ViewBag.Submissions as IList<BookPaymentSubmission>;
    var ledger = ViewBag.Ledger as IList<TheArqamSchools.Web.Data.BookCustomerAccountRepository.LedgerLine>;
    var accounts = ViewBag.Accounts as IList<BookAccount>;
    var owed = (decimal)ViewBag.Owed;
    var waitingAmount = (decimal)ViewBag.Waiting;
    var error = ViewBag.Error as string;
    var pk = TimeSpan.FromHours(5);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var toSend = owed - waitingAmount;
    // Recent: payments waiting or not accepted (not in the statement yet), then the statement, newest first.
    var recent = new List<Tuple<DateTimeOffset, string, string, string, string, string>>();   // when, icon class, title, detail, amount, amount class
    foreach (var sp in subs.Where(x => x.Status != "confirmed"))
    {
        recent.Add(Tuple.Create(sp.CreatedAt, sp.Status == "pending" ? "w" : "x", sp.Status == "pending" ? "Payment being checked" : "Payment not accepted",
            sp.CreatedAt.ToOffset(pk).ToString("d MMM", inv) + " \u00b7 " + sp.AccountName + (sp.OrderNo.HasValue ? " \u00b7 for " + BookFormat.OrderLabel(sp.OrderNo.Value) : "") + (sp.Status == "rejected" && !string.IsNullOrEmpty(sp.RejectReason) ? " \u00b7 " + sp.RejectReason : ""),
            BookFormat.Money(sp.Amount), ""));
    }
    foreach (var l in ledger)
    {
        var isOrder = l.Kind == "Order";
        var minus = l.CreditAmount > 0;
        recent.Add(Tuple.Create(l.At, isOrder ? "o" : minus ? "p" : "o",
            l.Kind == "Payment" ? "Payment received" : l.Kind == "Return" ? "Books returned" : l.Kind + (isOrder ? " " + l.Reference : ""),
            l.On.ToString("d MMM yyyy", inv) + (isOrder ? "" : " \u00b7 " + l.Reference) + (!string.IsNullOrEmpty(l.Details) && !isOrder ? " \u00b7 " + l.Details : ""),
            (minus ? "− " : "") + BookFormat.Money(minus ? l.CreditAmount : l.Debit), minus ? "is-minus" : ""));
    }
    recent = recent.OrderByDescending(r => r.Item1).Take(15).ToList();
}
<section class="section tone-white books books-app">
    <div class="container books-wide">
        @Html.Partial("~/Views/Books/_Who.cshtml", customer)
        <h1 class="sr-only">Payments</h1>
        @if ((bool)(ViewBag.Sent ?? false)) { <div class="alert alert-success" role="status" tabindex="-1" data-focus>@Icons.Svg("check-circle", 22)<p>Thank you. Your payment has been sent. The office will check the receipt; it is used for your oldest unpaid order first.</p></div> }
        @if (Request.QueryString["cash"] == "true") { <div class="alert alert-success" role="status" tabindex="-1" data-focus>@Icons.Svg("check-circle", 22)<p>Please pay @BookFormat.Money(Math.Max(0m, owed)) in cash at the office or when your books are delivered.</p></div> }
        @if (!string.IsNullOrEmpty(error)) { <div class="alert alert-error" role="alert" tabindex="-1" data-focus><p>@error</p></div> }

        <div class="books-due-box@(owed > 0 ? " is-due" : " is-ok")">
            <p class="books-due-label">Still to pay</p>
            <p class="books-due-value">@BookFormat.Money(Math.Max(0m, owed))</p>
            @if (waitingAmount > 0) { <p class="books-due-note">@BookFormat.Money(waitingAmount) sent by you is being checked by the office.</p> }
            @if (toSend > 0 && accounts != null)
            {
                <details class="books-paynow" id="make-payment" @(error != null ? "open" : null)>
                    <summary class="btn btn-primary books-btn-block">Pay now</summary>
                    <form method="post" action="/books/payments" enctype="multipart/form-data" class="books-pay-form" novalidate>
                        @Html.AntiForgeryToken()
                        <div class="hp" aria-hidden="true"><label for="mp-website">Website</label><input id="mp-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
                        <p class="books-pay-lead">Pay @BookFormat.Money(toSend) into one of these accounts and attach the receipt, or choose Cash. It is used for your oldest unpaid order first.</p>
                        @Html.Partial("~/Views/Books/_PayOptions.cshtml", accounts, new ViewDataDictionary { { "Id", "mp" } })
                        <button type="submit" class="btn btn-primary books-btn-block">Send payment</button>
                    </form>
                </details>
            }
            else if (owed <= 0)
            {
                <p class="books-due-note">Nothing to pay. Thank you.</p>
            }
        </div>

        <div class="books-recent-head">
            <h2 class="h3">Recent</h2>
            <a class="btn btn-outline btn-sm" href="/books/statement">Statement (PDF)</a>
        </div>
        @if (recent.Count == 0) { <p class="form-note">Nothing yet.</p> }
        else
        {
            <ul class="books-recent">
                @foreach (var r in recent)
                {
                    <li>
                        <span class="books-recent-ic is-@r.Item2" aria-hidden="true">@(r.Item2 == "p" ? "✓" : r.Item2 == "w" ? "…" : r.Item2 == "x" ? "!" : "B")</span>
                        <span class="books-recent-main">@r.Item3<small>@r.Item4</small></span>
                        <span class="books-recent-amt @r.Item6">@r.Item5</span>
                    </li>
                }
            </ul>
            <p class="form-note">The statement (PDF) has every entry and the balance after each one.</p>
        }
    </div>
</section>
<script src="~/Scripts/books.js?v=20261127a" defer></script>
