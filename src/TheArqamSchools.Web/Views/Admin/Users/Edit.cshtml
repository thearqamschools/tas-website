@model UserEditViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var f = Model.Form;
    ViewBag.Title = Model.IsNew ? "Add user" : f.FullName;
    var action = Model.IsNew ? "/admin/users/new" : "/admin/users/" + f.Id.ToString("D");
    var selected = f.RoleIds ?? new List<Guid>();
}
<p><a href="/admin/users">&larr; Users</a></p>
<h1>@(Model.IsNew ? "Add user" : f.FullName)</h1>

@if (Model.Notice != null)
{
    <div class="admin-alert admin-alert--success" role="status"><p>@Model.Notice</p></div>
}
@if (Model.TemporaryPassword != null)
{
    <section class="admin-card admin-temp-password" aria-labelledby="temp-heading">
        <h2 id="temp-heading">Temporary password (shown only once)</h2>
        <p><code>@Model.TemporaryPassword</code></p>
        <p class="admin-muted">Share it privately (in person or by phone call), not in a group. Sign-in address: <strong>/admin/login</strong>, email <strong>@f.Email</strong>.</p>
    </section>
}

@Html.Partial("~/Views/Admin/_Errors.cshtml")
<section class="admin-card">
    <form method="post" action="@action" class="admin-form" novalidate>
        @Html.AntiForgeryToken()
        <div class="admin-field">
            <label for="FullName">Full name</label>
            @Html.TextBox("FullName", f.FullName, new { autocomplete = "off", required = "required", maxlength = "120", aria_describedby = "FullName-error" })
            @Html.ValidationMessage("FullName", null, new { id = "FullName-error", @class = "admin-field-error" })
        </div>
        <div class="admin-field">
            <label for="Email">Email address</label>
            @Html.TextBox("Email", f.Email, new { type = "email", autocomplete = "off", autocapitalize = "none", spellcheck = "false", required = "required", maxlength = "254", aria_describedby = "Email-error" })
            @Html.ValidationMessage("Email", null, new { id = "Email-error", @class = "admin-field-error" })
        </div>
        <div class="admin-field">
            <label for="Phone">Phone (optional)</label>
            @Html.TextBox("Phone", f.Phone, new { type = "tel", autocomplete = "off", maxlength = "20", aria_describedby = "Phone-error" })
            @Html.ValidationMessage("Phone", null, new { id = "Phone-error", @class = "admin-field-error" })
        </div>
        <div class="admin-field">
            <label for="JobTitle">Job title (optional)</label>
            @Html.TextBox("JobTitle", f.JobTitle, new { autocomplete = "off", maxlength = "120" })
        </div>
        <fieldset class="admin-fieldset" aria-describedby="RoleIds-error">
            <legend>Roles</legend>
            @foreach (var r in Model.Roles)
            {
                var id = "role-" + r.Key;
                var isSuper = r.Key == "super_admin";
                var disabled = isSuper && !Model.ActorIsSuperAdmin;
                <div class="admin-check">
                    <input type="checkbox" id="@id" name="RoleIds" value="@r.Id" @(selected.Contains(r.Id) ? "checked" : null) @(disabled ? "disabled" : null) />
                    <label for="@id"><strong>@r.Name</strong>@if (!string.IsNullOrEmpty(r.Description)) { <span class="admin-hint">@r.Description</span> }</label>
                </div>
                if (disabled && selected.Contains(r.Id))
                {
                    <input type="hidden" name="RoleIds" value="@r.Id" />
                }
            }
            @Html.ValidationMessage("RoleIds", null, new { id = "RoleIds-error", @class = "admin-field-error" })
        </fieldset>
        @if (!Model.IsNew)
        {
            <div class="admin-check">
                <input type="checkbox" id="IsActive" name="IsActive" value="true" @(f.IsActive ? "checked" : null) @(Model.IsSelf ? "disabled" : null) />
                <input type="hidden" name="IsActive" value="@(Model.IsSelf ? "true" : "false")" />
                <label for="IsActive"><strong>Active</strong><span class="admin-hint">An inactive user cannot sign in and is signed out at once.</span></label>
            </div>
            @Html.ValidationMessage("IsActive", null, new { @class = "admin-field-error" })
        }
        <div>
            <button type="submit" class="admin-button">@(Model.IsNew ? "Create user" : "Save changes")</button>
        </div>
    </form>
</section>

@if (!Model.IsNew)
{
    <section class="admin-card">
        <h2>Sign-in</h2>
        <p class="admin-muted">
            Two-step verification: @(f.TwoFactorEnabled ? "set up" : "not set up yet")
            &middot; @(f.LastSignInAt.HasValue ? "last sign-in " + f.LastSignInAt.Value.ToOffset(TimeSpan.FromHours(5)).ToString("d MMM yyyy, h:mm tt") : "never signed in")
        </p>
        <div class="admin-status-form">
            @if (!Model.IsSelf)
            {
                <form method="post" action="/admin/users/@f.Id.ToString("D")/reset-password">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-button admin-button--secondary">Reset password</button>
                </form>
            }
            @if (f.TwoFactorEnabled)
            {
                <form method="post" action="/admin/users/@f.Id.ToString("D")/reset-two-step">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-button admin-button--secondary">Reset two-step verification (lost phone)</button>
                </form>
            }
        </div>
    </section>
}
