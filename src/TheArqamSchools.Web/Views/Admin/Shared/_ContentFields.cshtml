@model TheArqamSchools.Web.Models.ContentFieldsViewModel
@using TheArqamSchools.Web.Infrastructure
@{
    // The fields of a content form (page section or homepage). Fields that belong to one list item
    // (one stage, one person, one slide) are grouped in a box with buttons to move or remove the item;
    // each list ends with an "Add" button. All buttons save the form's changes first.
    var ro = Model.CanEdit ? null : "disabled";
    string openItem = null;
}
@helper FormatBar(string target)
{
    <div class="admin-format" role="toolbar" aria-label="Text style" aria-controls="@target" data-format-bar="@target" hidden>
        <button type="button" class="admin-format-btn" data-format="**" aria-label="Bold"><strong>B</strong></button>
        <button type="button" class="admin-format-btn" data-format="*" aria-label="Italic"><em>I</em></button>
    </div>
}
@for (var i = 0; i < Model.Fields.Count; i++)
{
    var fld = Model.Fields[i];
    var id = "v" + i;
    if (fld.ItemPath != openItem)
    {
        if (openItem != null)
        {
            var prev = Model.Fields[i - 1];
            @Html.Raw("</fieldset>")
            if (fld.ListPath != prev.ListPath && prev.ListPath != null && Model.CanEdit)
            {
                <div class="admin-list-add"><button type="submit" name="op" value="add:@prev.ListPath" class="admin-button admin-button--secondary">+ Add @prev.ItemNoun.ToLowerInvariant()</button></div>
            }
        }
        if (fld.ItemPath != null)
        {
            if (fld.ItemIndex == 0) { <span id="list-@fld.ListPath"></span> }
            @Html.Raw("<fieldset class=\"admin-group\" id=\"item-" + HttpUtility.HtmlAttributeEncode(fld.ListPath + "-" + fld.ItemIndex) + "\">")
            <legend>@fld.ItemLabel</legend>
            if (Model.CanEdit)
            {
                <div class="admin-group-actions">
                    @if (fld.ItemIndex > 0) { <button type="submit" name="op" value="up:@fld.ListPath:@fld.ItemIndex" class="admin-link-button" aria-label="Move @fld.ItemLabel up">&uarr; Up</button> }
                    @if (fld.ItemIndex < fld.ListCount - 1) { <button type="submit" name="op" value="down:@fld.ListPath:@fld.ItemIndex" class="admin-link-button" aria-label="Move @fld.ItemLabel down">&darr; Down</button> }
                    @if (fld.ListCount > 1) { <button type="submit" name="op" value="remove:@fld.ListPath:@fld.ItemIndex" class="admin-link-button admin-danger" data-confirm="Remove @fld.ItemLabel? Your other changes are saved too.">Remove</button> }
                </div>
            }
        }
        openItem = fld.ItemPath;
    }
    var label = fld.Label;
    if (fld.Kind == JsonContentFields.FieldKind.Switch)
    {
        <div class="admin-check">
            <input type="checkbox" id="@id" name="@id" value="true" @(fld.Value == "true" ? "checked" : null) @ro />
            <input type="hidden" name="@id" value="false" />
            <label for="@id"><strong>@label</strong></label>
        </div>
    }
    else if (fld.Kind == JsonContentFields.FieldKind.Image)
    {
        // Pictures (owner's request, 21 November 2026): a card per picture with a preview, "Choose file" below it, an X to
        // remove it and an instant preview of a new file. Pictures of the same item (a slide's computer and phone photos)
        // sit side by side. The homepage slides also get "Adjust": drag to move, zoom, reset; the file is not changed.
        var prevImg = i > 0 && Model.Fields[i - 1].Kind == JsonContentFields.FieldKind.Image && Model.Fields[i - 1].ItemPath == fld.ItemPath;
        var nextImg = i + 1 < Model.Fields.Count && Model.Fields[i + 1].Kind == JsonContentFields.FieldKind.Image && Model.Fields[i + 1].ItemPath == fld.ItemPath;
        var slide = System.Text.RegularExpressions.Regex.Match(fld.Path ?? "", @"^slides\[\d+\]\.(image|mobile_image)$");
        var frame = !slide.Success ? null : slide.Groups[1].Value == "image" ? "desktop" : "mobile";
        var title = frame == "desktop" ? "For website" : frame == "mobile" ? "For phone" : label;
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        Func<double?, string> num = v => v.HasValue ? v.Value.ToString("0.##", inv) : "";
        if (!prevImg) { @Html.Raw("<div class=\"admin-img-grid\">") }
        <div class="admin-img-card@(fld.ImageUrl == null ? " is-empty" : "")" data-img-card @(frame != null ? "data-frame=" + frame : null)>
            <p class="admin-img-title">@title</p>
            @if (frame == "desktop") { <p class="admin-hint">A wide photo, about 2000 &times; 800 pixels. Shown behind the text on computers.</p> }
            else if (frame == "mobile") { <p class="admin-hint">An upright photo, about 660 &times; 800 pixels. Shown at the top on phones.</p> }
            else if (title != label) { <p class="admin-hint">@label</p> }
            <div class="admin-img-frame@(frame != null ? " admin-img-frame--" + frame : "")" data-img-frame>
                <img src="@fld.ImageUrl" alt="@(fld.ImageUrl != null ? "Current picture: " + fld.Alt : "")" data-img-preview @(fld.ImageUrl == null ? "hidden" : null) draggable="false" />
                <span class="admin-img-none" data-img-none @(fld.ImageUrl != null ? "hidden" : null)>No picture yet</span>
                @if (Model.CanEdit && fld.ImageUrl != null)
                {
                    <button type="button" class="admin-img-x" data-img-remove aria-label="Remove this picture (@title)" title="Remove this picture" hidden>&times;</button>
                    <div class="admin-img-removed" data-img-removed hidden><p>This picture will be removed when you save.</p><button type="button" class="admin-button admin-button--secondary" data-img-undo>Undo</button></div>
                }
            </div>
            @if (Model.CanEdit)
            {
                <div class="admin-img-tools">
                    <input type="file" id="f@(i)" name="f@(i)" accept="image/jpeg,image/png" class="admin-file-input" aria-describedby="fh@(i)" data-img-file />
                    <label class="admin-button admin-button--secondary admin-file-button" for="f@(i)">@(fld.ImageUrl != null ? "Choose a new file" : "Choose file")</label>
                    @if (frame != null) { <button type="button" class="admin-button admin-button--secondary" data-img-adjust aria-expanded="false" @(fld.ImageUrl == null ? "hidden" : null)>Adjust</button> }
                    <span class="admin-img-filename" data-img-filename aria-live="polite"></span>
                </div>
                if (frame != null)
                {
                    <div class="admin-img-adjust" data-img-adjust-panel hidden>
                        <p class="admin-hint">Drag the photo (or use the arrow keys) to move it. The frame has the same shape as on the website.</p>
                        <div class="admin-img-zoom">
                            <label for="zr@(i)">Zoom</label>
                            <input type="range" id="zr@(i)" min="1" max="3" step="0.05" value="@(fld.Zoom.HasValue ? num(fld.Zoom) : "1")" data-img-zoom />
                            <button type="button" class="admin-button admin-button--secondary" data-img-reset>Reset</button>
                            <button type="button" class="admin-button" data-img-done>Done</button>
                        </div>
                    </div>
                    <input type="hidden" name="x@(i)" value="@num(fld.FocusX)" data-img-x data-default="@(frame == "desktop" ? "70" : "50")" />
                    <input type="hidden" name="y@(i)" value="@num(fld.FocusY)" data-img-y data-default="@(frame == "desktop" ? "50" : "20")" />
                    <input type="hidden" name="z@(i)" value="@num(fld.Zoom)" data-img-z />
                }
                <p class="admin-hint" id="fh@(i)">JPG or PNG, up to 15 MB. Change one or two photos at a time (all photos in one save: up to 18 MB together).</p>
                if (fld.ImageUrl != null)
                {
                    <div class="admin-check admin-check-small" data-img-nojs>
                        <input type="checkbox" id="r@(i)" name="r@(i)" value="true" data-img-remove-box />
                        <label for="r@(i)">Remove this picture</label>
                    </div>
                }
            }
            <div class="admin-field admin-img-alt">
                <label for="a@(i)" class="admin-hint-label">Picture description (for blind visitors and Google)</label>
                <input type="text" id="a@(i)" name="a@(i)" value="@fld.Alt" maxlength="250" @ro />
            </div>
        </div>
        if (!nextImg) { @Html.Raw("</div>") }
    }
    else
    {
        <div class="admin-field">
            <label for="@id">@label</label>
            @if (fld.Formatted && Model.CanEdit) { @FormatBar(id) }
            @if (fld.Kind == JsonContentFields.FieldKind.LongText)
            {
                <textarea id="@id" name="@id" rows="@(Math.Min(12, Math.Max(3, (fld.Value ?? "").Length / 70 + 1)))" @ro>@fld.Value</textarea>
            }
            else if (fld.Kind == JsonContentFields.FieldKind.Number)
            {
                <input type="text" inputmode="decimal" id="@id" name="@id" value="@fld.Value" @ro />
            }
            else
            {
                <input type="text" id="@id" name="@id" value="@fld.Value" @(fld.Kind == JsonContentFields.FieldKind.Link ? "spellcheck=false autocapitalize=none" : null) @ro />
                if (fld.Kind == JsonContentFields.FieldKind.Link)
                {
                    <p class="admin-hint">A page on this website such as /admissions, or a full address starting with https://</p>
                }
            }
        </div>
    }
}
@if (openItem != null)
{
    var last = Model.Fields[Model.Fields.Count - 1];
    @Html.Raw("</fieldset>")
    if (Model.CanEdit)
    {
        <div class="admin-list-add"><button type="submit" name="op" value="add:@last.ListPath" class="admin-button admin-button--secondary">+ Add @last.ItemNoun.ToLowerInvariant()</button></div>
    }
}
