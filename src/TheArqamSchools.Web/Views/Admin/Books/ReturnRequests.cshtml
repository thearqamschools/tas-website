@model IList<TheArqamSchools.Web.Data.BookReturnRequestRepository.Request>
@using TheArqamSchools.Web.Helpers
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewBag.Title = "Return requests";
    var st = ViewBag.Status as string;
    var pk = TimeSpan.FromHours(5);
}
<div class="admin-page-head"><h1>Return requests</h1></div>
@Html.Partial("~/Views/Admin/Books/_Tabs.cshtml", "customer-accounts")
<nav class="admin-subtabs" aria-label="Status">
    @foreach (var v in new[] { new[] { "", "All" }, new[] { "requested", "New" }, new[] { "approved", "Approved, books to come" }, new[] { "received", "Received" }, new[] { "rejected", "Not approved" } })
    {
        <a href="/admin/books/return-requests@(v[0] == "" ? "" : "?status=" + v[0])" @((st ?? "") == v[0] ? "aria-current=page" : null)>@v[1]</a>
    }
</nav>
@if (Model.Count == 0) { <section class="admin-card"><p>No return requests.</p></section> }
else
{
    <div class="admin-table-wrap admin-table-wrap--fit">
        <table class="admin-table admin-table--orders">
            <thead><tr><th scope="col">Request</th><th scope="col">Date</th><th scope="col">Customer</th><th scope="col">Books</th><th scope="col">Money</th><th scope="col">Status</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr class="admin-row-link" data-href="/admin/books/return-requests/@r.ReturnNo">
                        <td><a href="/admin/books/return-requests/@r.ReturnNo"><strong>@r.Label</strong></a></td>
                        <td>@r.CreatedAt.ToOffset(pk).ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@r.CustomerName<span class="admin-cell-sub">@BookFormat.CustomerLabel(r.CustomerNo) &middot; @Mobile.Format(r.CustomerMobile)</span></td>
                        <td>@r.Lines.Sum(l => l.Quantity)</td>
                        <td>@(r.Choice == "refund" ? "Pay back" : "Keep as credit")</td>
                        <td>@r.StatusLabel</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<script src="/Scripts/admin-form.js?v=20261120c" defer></script>
