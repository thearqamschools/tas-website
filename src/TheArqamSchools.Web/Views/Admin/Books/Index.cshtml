@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewBag.Title = "Books";
    var low = ViewBag.LowStock as IList<BookItem>;
}
<div class="admin-page-head"><h1>Books</h1><a href="/books" target="_blank" rel="noopener">Open the order page</a></div>
@Html.Partial("~/Views/Admin/Books/_Tabs.cshtml", "home")
@if (!string.IsNullOrEmpty(Request.Unvalidated.QueryString["error"])) { <div class="admin-alert admin-alert--error" role="alert"><p>@Request.Unvalidated.QueryString["error"]</p></div> }
@if (Request.QueryString["notice"] == "sentconfirmed") { <div class="admin-alert admin-alert--success" role="status"><p>Payment confirmed and recorded.</p></div> }
@if (Request.QueryString["notice"] == "sentrejected") { <div class="admin-alert admin-alert--success" role="status"><p>Payment marked as not accepted. A message for the customer is ready under Messages.</p></div> }
@{ var td = TheArqamSchools.Web.Data.BookCustomerAccountRepository.GetToDo(); }
<section class="admin-card" aria-labelledby="todo-h">
    <h2 id="todo-h">Books: work to do</h2>
    <div class="admin-todo">
        <a class="@(td.NewOrders > 0 ? "has-work" : null)" href="/admin/books/orders?status=new"><strong>@td.NewOrders</strong>New orders</a>
        <a class="@(td.PaymentsToCheck > 0 ? "has-work" : null)" href="/admin/books/orders?payment=tocheck"><strong>@td.PaymentsToCheck</strong>Payments to check</a>
        <a class="@(td.RefundsPending > 0 ? "has-work" : null)" href="/admin/books/customer-accounts"><strong>@td.RefundsPending</strong>Refunds to pay back</a>
        <a class="@(td.ReturnRequests + td.ReturnsToReceive > 0 ? "has-work" : null)" href="/admin/books/return-requests"><strong>@(td.ReturnRequests + td.ReturnsToReceive)</strong>Return requests</a>
        <a class="@(td.MessagesToSend > 0 ? "has-work" : null)" href="/admin/books/messages"><strong>@td.MessagesToSend</strong>Messages to send</a>
        <a class="@(td.OverdueCustomers > 0 ? "has-work" : null)" href="/admin/books/reports?kind=aging"><strong>@td.OverdueCustomers</strong>Customers overdue</a>
    </div>
</section>

@{ var toCheck = TheArqamSchools.Web.Data.BookPaymentSubmissionRepository.Pending(30); var canPay = TheArqamSchools.Web.Infrastructure.Auth.AdminAuth.Current(Context).Can("books.payments"); }
@if (toCheck.Count > 0)
{
    <section class="admin-card" id="sent" aria-labelledby="tocheck-h">
        <h2 id="tocheck-h">Payments to check (@td.PaymentsToCheck)</h2>
        <p class="admin-muted">Open the receipt, check the money in the bank, enter the amount on the receipt and confirm. Oldest first.</p>
        @foreach (var sp in toCheck)
        {
            @Html.Partial("~/Views/Admin/Books/_SentPayment.cshtml", sp, new ViewDataDictionary { { "CanPay", canPay }, { "Back", "home" } })
        }
    </section>
}

<div class="admin-stats">
    <a class="admin-stat" href="/admin/books/items"><p class="admin-stat-value">@ViewBag.ItemCount</p><p class="admin-stat-label">books on sale</p></a>
    <a class="admin-stat" href="/admin/books/customers"><p class="admin-stat-value">@ViewBag.CustomerCount</p><p class="admin-stat-label">customers</p></a>
    <a class="admin-stat@(low.Count > 0 ? " admin-stat--warn" : "")" href="/admin/books/items"><p class="admin-stat-value">@low.Count</p><p class="admin-stat-label">books at or below their minimum stock</p></a>
</div>
@if (low.Count > 0)
{
    <section class="admin-card">
        <h2>Low stock</h2>
        <ul class="admin-list">
            @foreach (var b in low)
            {
                <li class="admin-list-item"><a class="admin-list-link" href="/admin/books/items/@b.Id.ToString("D")"><span class="admin-list-main"><strong>@b.ClassName &ndash; @b.Name</strong></span><span class="admin-list-meta">@b.Stock in stock &middot; minimum @b.WarnAt</span></a></li>
            }
        </ul>
    </section>
}
@if ((int)ViewBag.NeverStocked > 0)
{
    <p class="admin-muted">@ViewBag.NeverStocked book(s) have no stock entered yet; they are not listed as low stock. Customers see a book only when it has stock.</p>
}
<section class="admin-card">
    <h2>How it works</h2>
    <ol class="admin-steps">
        <li>Add the books with their class, vendor, purchase price, retail price and discount (the sale price is worked out), then add the stock received and, if needed, the book's minimum stock level.</li>
        <li>Register each customer (a branch, a book shop or anyone else) with the mobile number, name, campus and address.</li>
        <li>Customers open <strong>Books</strong> on the website, enter that mobile number and place their order.</li>
    </ol>
</section>
