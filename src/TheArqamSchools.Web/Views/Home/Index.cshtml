@using System.Collections.Generic
@using TheArqamSchools.Web.Helpers
@helper Placeholder(string label, string ratioClass)
{
    @* Stand-in for a real TAS photograph. Never an authentic photo: the label is visible and is also the accessible name. *@
    <figure class="home-ph @ratioClass" role="img" aria-label="@label">
        <svg class="home-ph-art" viewBox="0 0 400 300" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
            <path class="ph-window" d="M52 238V104a64 64 0 0 1 128 0v134z" />
            <path class="ph-pane" d="M116 40v198M52 120h128" />
            <g class="ph-shelf">
                <rect x="224" y="86" width="132" height="8" rx="3" />
                <rect x="224" y="150" width="132" height="8" rx="3" />
                <rect x="224" y="214" width="132" height="8" rx="3" />
            </g>
            <g class="ph-book-a">
                <rect x="232" y="54" width="14" height="32" rx="2" />
                <rect x="262" y="62" width="14" height="24" rx="2" />
                <rect x="320" y="118" width="14" height="32" rx="2" />
                <rect x="240" y="182" width="14" height="32" rx="2" />
            </g>
            <g class="ph-book-b">
                <rect x="248" y="48" width="12" height="38" rx="2" />
                <rect x="296" y="124" width="14" height="26" rx="2" />
                <rect x="276" y="190" width="14" height="24" rx="2" />
                <rect x="326" y="180" width="14" height="34" rx="2" />
            </g>
            <g class="ph-book-c">
                <rect x="280" y="56" width="14" height="30" rx="2" />
                <rect x="234" y="126" width="14" height="24" rx="2" />
                <rect x="258" y="186" width="12" height="28" rx="2" />
            </g>
            <rect class="ph-desk" x="0" y="238" width="400" height="62" />
        </svg>
        <span class="home-ph-label">@label</span>
    </figure>
}
@{
    ViewBag.Meta = ViewBag.Meta as PageMeta;
    // The admissions banner at the end of the page replaces the footer call to action here.
    ViewBag.HideFooterCta = true;
    // Campus finder data comes from the controller (published campuses only). Cast safely: either list may be missing or empty.
    var cities = ViewBag.Cities as IList<FilterOption>;
    var campuses = ViewBag.Campuses as IList<Campus>;
    var hasCities = cities != null && cities.Count > 0;
    var hasCampuses = campuses != null && campuses.Count > 0;
    var news = ViewBag.News as IList<NewsItem>;
    var hasNews = news != null && news.Count > 0;
    // Words and pictures edited in the admin panel (Home Page); built-in copy when not set.
    var home = HomeContent.Get(TheArqamSchools.Web.Data.SiteSettingsRepository.Public());
    var slides = HomeContent.List(home, "slides").Where(sl => Media.Url(sl["image"]) != null).ToList();
    var wholeImg = home["whole_child_image"];
}
<div class="home">

    @* 1. Hero: full-width classroom photo; the text sits on the photo's blue left side. *@
    <section class="home-hero home-hero-photo@(slides.Count > 1 ? " home-hero-slides" : "")" @(slides.Count > 1 ? "data-hero-slider" : null)>
        @for (var si = 0; si < slides.Count; si++)
        {
            var sl = slides[si];
            var desk = Media.Url(sl["image"]);
            var mob = Media.Url(sl["mobile_image"]) ?? desk;
            <picture class="home-hero-bg@(si == 0 ? " is-active" : "")" @(si > 0 ? "data-lazy" : null)>
                <source media="(min-width: 48rem)" srcset="@(si == 0 ? desk : null)" data-srcset="@desk" />
                <img src="@(si == 0 ? mob : null)" data-src="@mob" alt="" @(si == 0 ? "fetchpriority=high" : "loading=lazy") decoding="async" />
            </picture>
        }
        <div class="container home-hero-inner">
            <div class="home-hero-text">
                @if (!string.IsNullOrWhiteSpace(HomeContent.Text(home, "hero_badge"))) { <p class="home-hero-badge">@HomeContent.Text(home, "hero_badge")</p> }
                <h1 class="h1"><span class="home-h1-line">@HomeContent.Text(home, "hero_line_1")</span> <span class="home-h1-line">@HomeContent.Text(home, "hero_line_2")</span></h1>
                <p class="lead">@SimpleFormat.Render(HomeContent.Text(home, "hero_intro"))</p>
                <div class="btn-row">
                    @if (!string.IsNullOrWhiteSpace(HomeContent.Text(home["hero_primary_cta"], "label"))) { <a class="btn btn-primary btn-arrow" href="@HomeContent.Href(home["hero_primary_cta"])">@HomeContent.Text(home["hero_primary_cta"], "label") @Icons.Svg("arrow-right", 18)</a> }
                    @if (!string.IsNullOrWhiteSpace(HomeContent.Text(home["hero_secondary_cta"], "label"))) { <a class="btn btn-outline-light" href="@HomeContent.Href(home["hero_secondary_cta"])">@HomeContent.Text(home["hero_secondary_cta"], "label")</a> }
                </div>
            </div>
        </div>
        @if (slides.Count > 1)
        {
            <div class="home-hero-controls">
                <button type="button" class="home-hero-pause" data-hero-pause aria-label="Pause the photos"><span aria-hidden="true" class="home-hero-pause-icon"></span></button>
                @for (var si = 0; si < slides.Count; si++)
                {
                    <button type="button" class="home-hero-dot@(si == 0 ? " is-active" : "")" data-hero-dot="@si" aria-label="Show photo @(si + 1) of @slides.Count" @(si == 0 ? "aria-current=true" : null)></button>
                }
            </div>
        }
    </section>

    @* 2. Figures band: the approved figures, plus 34 years of excellence (given by the school, 3 November 2026). *@
    <section class="home-figures" aria-labelledby="home-figures-h">
        <div class="container">
            <h2 class="sr-only" id="home-figures-h">The Arqam Schools at a glance</h2>
            <ul class="home-figures-list">
                @foreach (var fg in HomeContent.List(home, "figures").Where(x => !string.IsNullOrWhiteSpace(HomeContent.Text(x, "value"))))
                {
                    <li><span class="home-fig">@HomeContent.Text(fg, "value")</span> <span class="home-fig-label">@HomeContent.Text(fg, "label")</span></li>
                }
            </ul>
        </div>
    </section>

    @* 3. Explore: the four existing links as wide, tinted, whole-tile links. *@
    <section class="section tone-white" aria-labelledby="explore-h">
        <div class="container">
            <div class="section-head"><h2 class="h2" id="explore-h">@HomeContent.Text(home, "explore_heading")</h2></div>
            <ul class="home-tiles">
                @foreach (var tl in HomeContent.List(home, "tiles").Where(x => !string.IsNullOrWhiteSpace(HomeContent.Text(x, "title"))))
                {
                    var thref = HomeContent.Href(tl);
                    <li class="home-reveal">
                        <article class="home-tile@(thref == "/admissions" ? " home-tile-action" : "")">
                            <span class="home-tile-icon">@Icons.Svg(string.IsNullOrEmpty(HomeContent.Text(tl, "icon")) ? "arrow-right" : HomeContent.Text(tl, "icon"), 26)</span>
                            <div class="home-tile-text">
                                <h3 class="h4"><a href="@thref">@HomeContent.Text(tl, "title")</a></h3>
                                @if (!string.IsNullOrWhiteSpace(HomeContent.Text(tl, "text"))) { <p>@SimpleFormat.Render(HomeContent.Text(tl, "text"))</p> }
                            </div>
                            <span class="home-tile-arrow" aria-hidden="true">@Icons.Svg("arrow-right", 20)</span>
                        </article>
                    </li>
                }
            </ul>
        </div>
    </section>

    @* 4. Educating the whole child. PROPOSED copy: needs the school's approval (see DESIGN-NOTES.md, "Proposed copy for approval"). *@
    <section class="section tone-warm" aria-labelledby="values-h">
        <div class="container home-split">
            <div class="home-split-text home-reveal">
                <h2 class="h2" id="values-h">@HomeContent.Text(home, "whole_child_heading")</h2>
                <p class="home-split-lead">@SimpleFormat.Render(HomeContent.Text(home, "whole_child_lead"))</p>
                <ul class="home-points">
                    @foreach (var pt in HomeContent.List(home, "whole_child_points").Where(x => !string.IsNullOrWhiteSpace(HomeContent.Text(x, "title"))))
                    {
                        <li>
                            <span class="home-point-icon">@Icons.Svg(string.IsNullOrEmpty(HomeContent.Text(pt, "icon")) ? "check-circle" : HomeContent.Text(pt, "icon"), 22)</span>
                            <div>
                                <h3 class="h4">@HomeContent.Text(pt, "title")</h3>
                                @if (!string.IsNullOrWhiteSpace(HomeContent.Text(pt, "text"))) { <p>@SimpleFormat.Render(HomeContent.Text(pt, "text"))</p> }
                            </div>
                        </li>
                    }
                </ul>
                @if (!string.IsNullOrWhiteSpace(HomeContent.Text(home["whole_child_link"], "label"))) { <a class="text-link" href="@HomeContent.Href(home["whole_child_link"])">@HomeContent.Text(home["whole_child_link"], "label") @Icons.Svg("arrow-right", 18)</a> }
            </div>
            <div class="home-split-art home-reveal">
@if (Media.Url(wholeImg) != null)
                {
                <figure class="home-photo">
                    <img src="@Media.Url(wholeImg)" alt="@Media.Alt(wholeImg)" width="@(wholeImg.Value<int?>("width") ?? 1200)" height="@(wholeImg.Value<int?>("height") ?? 805)" loading="lazy" decoding="async" />
                </figure>
                }
            </div>
        </div>
    </section>

    @* 5. Latest news and events: the newest three published items. Hidden until the school publishes some. *@
    @if (hasNews)
    {
        <section class="section tone-white" aria-labelledby="news-h">
            <div class="container">
                <div class="section-head home-news-head">
                    <h2 class="h2" id="news-h">@HomeContent.Text(home, "news_heading")</h2>
                    <a class="text-link" href="/news-events">All news and events @Icons.Svg("arrow-right", 18)</a>
                </div>
                <ul class="card-grid cols-3 news-grid">
                    @foreach (var n in news)
                    {
                        <li class="home-reveal">
                            @Html.Partial("~/Views/NewsEvents/_Card.cshtml", n)
                        </li>
                    }
                </ul>
            </div>
        </section>
    }

    @* 6. Campus finder: search form, city links and up to three campuses from the database. Nothing is hard-coded. *@
    <section class="section tone-grey" id="find" aria-labelledby="finder-h">
        <div class="container">
            <div class="section-head">
                <h2 class="h2" id="finder-h">@HomeContent.Text(home, "finder_heading")</h2>
                <p class="lead">@SimpleFormat.Render(HomeContent.Text(home, "finder_lead"))</p>
            </div>
            <div class="home-finder home-reveal">
                <form class="home-search" method="get" action="/campuses" role="search" aria-label="Search campuses">
                    <div class="field">
                        <label for="home-q">Campus name, area or address</label>
                        <div class="input-icon">
                            @Icons.Svg("search", 20)
                            <input id="home-q" name="q" type="search" maxlength="100" placeholder="For example, Samanabad" autocomplete="off" enterkeyhint="search" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-outline">Search campuses</button>
                </form>
                @if (hasCities)
                {
                    <div class="home-cities">
                        <h3 class="h4" id="home-cities-h">Browse by city</h3>
                        <ul class="home-city-list" aria-labelledby="home-cities-h">
                            @foreach (var city in cities)
                            {
                                if (string.IsNullOrWhiteSpace(city.Slug)) { continue; }
                                var cityHref = "/campuses/" + Url.Encode(city.Slug);
                                <li><a class="home-city" href="@cityHref">@city.Name <span class="home-city-count">@city.Count @(city.Count == 1 ? "campus" : "campuses")</span></a></li>
                            }
                        </ul>
                    </div>
                }
            </div>

            @if (hasCampuses)
            {
                <ul class="home-campus-grid">
                    @foreach (var c in campuses)
                    {
                        if (string.IsNullOrWhiteSpace(c.CitySlug) || string.IsNullOrWhiteSpace(c.Slug)) { continue; }
                        var campusHref = "/campuses/" + Url.Encode(c.CitySlug) + "/" + Url.Encode(c.Slug);
                        <li class="home-reveal">
                            <article class="home-campus">
                                <h3 class="h4"><a href="@campusHref">@c.Name</a></h3>
                                @if (!string.IsNullOrWhiteSpace(c.Locality))
                                {
                                    <p class="home-campus-place">@Icons.Svg("map-pin", 16) <span>@c.Locality</span></p>
                                }
                                @if (!string.IsNullOrWhiteSpace(c.AddressLine))
                                {
                                    <p class="home-campus-address">@c.AddressLine</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(c.Phone))
                                {
                                    <p class="home-campus-phone"><a href="@Contact.TelUrl(c.Phone)">@Icons.Svg("phone", 16) <span>@c.Phone</span></a></p>
                                }
                            </article>
                        </li>
                    }
                </ul>
            }

            <div class="home-finder-foot">
                <a class="text-link" href="/campuses">See all campuses @Icons.Svg("arrow-right", 18)</a>
            </div>
        </div>
    </section>

    @* 7. Admissions banner (session 2026-27, given by the school). *@
    <section class="section tone-white home-admit-wrap" aria-labelledby="admit-h">
        <div class="container">
            <div class="home-admit home-reveal">
                <div class="home-admit-text">
                    <h2 class="h2" id="admit-h">@HomeContent.Text(home, "admissions_heading")</h2>
                    <p>@SimpleFormat.Render(HomeContent.Text(home, "admissions_body"))</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(HomeContent.Text(home["admissions_cta"], "label"))) { <a class="btn btn-navy btn-arrow" href="@HomeContent.Href(home["admissions_cta"])">@HomeContent.Text(home["admissions_cta"], "label") @Icons.Svg("arrow-right", 18)</a> }
            </div>
        </div>
    </section>
</div>
