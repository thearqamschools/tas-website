@model IList<TheArqamSchools.Web.Data.BookMessageRepository.Message>
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewBag.Title = "Messages to send";
}
<div class="admin-page-head"><h1>Messages to send</h1></div>
@Html.Partial("~/Views/Admin/Books/_Tabs.cshtml", "home")
<p class="admin-muted">Messages written by the website for customers. Copy each one into WhatsApp or SMS, then mark it as sent. The full history is on each customer's account (Messages).</p>
@if (Model.Count == 0) { <section class="admin-card"><p>No messages waiting.</p></section> }
@foreach (var m in Model)
{
    @Html.Partial("~/Views/Admin/Books/_Message.cshtml", m, new ViewDataDictionary { { "back", "list" } })
}
<script src="/Scripts/admin-form.js?v=20261120c" defer></script>
