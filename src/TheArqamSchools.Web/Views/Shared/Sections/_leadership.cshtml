@model PageSection
@using TheArqamSchools.Web.Helpers
@{
    // Leadership: items { name, role, message, image }. Items without a name are skipped. Each card has a photo
    // space; until the school sends a photo (image.path) it shows the initials and "Photo to be added".
    var items = (Model.Data["items"] as Newtonsoft.Json.Linq.JArray ?? new Newtonsoft.Json.Linq.JArray())
        .OfType<Newtonsoft.Json.Linq.JObject>()
        .Where(i => !string.IsNullOrWhiteSpace(i.Value<string>("name")))
        .ToList();
}
@if (items.Count > 0)
{
    <section class="section tone-@Model.Tone("grey")" @(Model.Anchor != null ? "id=" + Model.Anchor : "") aria-labelledby="h-@Model.Id">
        <div class="container">
            <div class="section-head">
                <h2 class="h2" id="h-@Model.Id">@(string.IsNullOrEmpty(Model.Text("heading")) ? "Our leadership" : Model.Text("heading"))</h2>
                @if (!string.IsNullOrEmpty(Model.Text("intro"))) { <p class="lead">@SimpleFormat.Render(Model.Text("intro"))</p> }
            </div>
            <ul class="card-grid cols-3">
                @foreach (var i in items)
                {
                    var name = i.Value<string>("name");
                    var titles = new[] { "mr.", "mrs.", "ms.", "dr.", "prof.", "mr", "mrs", "ms", "dr", "prof" };
                    var initials = string.Concat(name.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Where(w => char.IsLetter(w[0]) && !titles.Contains(w.ToLowerInvariant())).Take(2).Select(w => char.ToUpperInvariant(w[0])));
                    var img = i["image"];
                    var imgUrl = TheArqamSchools.Web.Helpers.Media.Url(img);
                    <li>
                        <article class="card leader-card">
                            <div class="leader-photo">
                                @if (imgUrl != null)
                                {
                                    <img src="@imgUrl" alt="@(string.IsNullOrEmpty(TheArqamSchools.Web.Helpers.Media.Alt(img)) ? name : TheArqamSchools.Web.Helpers.Media.Alt(img))" width="@(img.Value<int?>("width") ?? 400)" height="@(img.Value<int?>("height") ?? 480)" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <span class="leader-photo-empty"><span class="leader-initials" aria-hidden="true">@initials</span><span class="leader-photo-note">Photo to be added</span></span>
                                }
                            </div>
                            <div class="card-body">
                                <h3 class="h4">@name</h3>
                                @{
                                    // Only the role ("Chief Executive Officer"): the site is The Arqam Schools' own, so the
                                    // organisation after the comma ("The Arqam Schools Pakistan") is not repeated (owner, 7 November 2026).
                                    var role = i.Value<string>("role") ?? "";
                                    var comma = role.IndexOf(", ", StringComparison.Ordinal);
                                }
                                @if (!string.IsNullOrWhiteSpace(role))
                                {
                                    <p class="card-meta leader-role">
                                        @if (comma > 0)
                                        {
                                            @role.Substring(0, comma)
                                        }
                                        else
                                        {
                                            @role
                                        }
                                    </p>
                                }
                                @if (!string.IsNullOrWhiteSpace(i.Value<string>("message"))) { <p>@SimpleFormat.Render(i.Value<string>("message"))</p> }
                            </div>
                        </article>
                    </li>
                }
            </ul>
        </div>
    </section>
}
