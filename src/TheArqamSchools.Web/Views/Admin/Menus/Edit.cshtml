@model MenuItemEditViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var f = Model.Form;
    ViewBag.Title = Model.IsNew ? "Add menu item" : f.Label;
    var action = Model.IsNew ? "/admin/menus/" + f.MenuId.ToString("D") + "/new" : "/admin/menus/items/" + f.Id.ToString("D");
    var ro = Model.CanEdit ? null : "disabled";
    Func<string, string, string> val = (name, fallback) => ViewData.ModelState.ContainsKey(name) && ViewData.ModelState[name].Value != null ? ViewData.ModelState[name].Value.AttemptedValue : fallback;
}
<p><a href="/admin/menus">&larr; Menus</a></p>
<h1>@(Model.IsNew ? "Add item to " + Model.Menu.Name : f.Label)</h1>
@if (Model.Notice != null)
{
    <div class="admin-alert admin-alert--success" role="status"><p>@Model.Notice</p></div>
}
@Html.Partial("~/Views/Admin/_Errors.cshtml")
<section class="admin-card">
    <form method="post" action="@action" class="admin-form" novalidate>
        @Html.AntiForgeryToken()
        <div class="admin-field">
            <label for="Label">Menu text</label>
            <input type="text" id="Label" name="Label" value="@val("Label", f.Label)" maxlength="60" required aria-describedby="Label-error" @ro />
            @Html.ValidationMessage("Label", null, new { id = "Label-error", @class = "admin-field-error" })
        </div>
        <fieldset class="admin-fieldset">
            <legend>Link to</legend>
            <div class="admin-check">
                <input type="radio" id="LinkType-page" name="LinkType" value="page" @(f.LinkType != "url" ? "checked" : null) @ro />
                <label for="LinkType-page"><strong>A page on this website</strong></label>
            </div>
            <div class="admin-field">
                <label for="PageId" class="admin-visually-hidden">Page</label>
                <select id="PageId" name="PageId" aria-describedby="PageId-error" @ro>
                    <option value="">Choose a page</option>
                    @foreach (var p in Model.Pages)
                    {
                        <option value="@p.Id" @(f.PageId == p.Id ? "selected" : null)>@p.Path &mdash; @(p.Title + (p.Status != "published" ? " (not published)" : ""))</option>
                    }
                </select>
                @Html.ValidationMessage("PageId", null, new { id = "PageId-error", @class = "admin-field-error" })
            </div>
            <div class="admin-check">
                <input type="radio" id="LinkType-url" name="LinkType" value="url" @(f.LinkType == "url" ? "checked" : null) @ro />
                <label for="LinkType-url"><strong>Another address</strong><span class="admin-hint">For example /campuses or https://www.facebook.com/TASHeadOffice</span></label>
            </div>
            <div class="admin-field">
                <label for="Url" class="admin-visually-hidden">Address</label>
                <input type="text" id="Url" name="Url" value="@val("Url", f.Url)" maxlength="300" spellcheck="false" autocapitalize="none" aria-describedby="Url-error" @ro />
                @Html.ValidationMessage("Url", null, new { id = "Url-error", @class = "admin-field-error" })
            </div>
        </fieldset>
        <div class="admin-grid-2">
            <div class="admin-field">
                <label for="ParentId">Position</label>
                <select id="ParentId" name="ParentId" aria-describedby="ParentId-error" @ro>
                    <option value="">Main menu item</option>
                    @foreach (var i in Model.Menu.Items.Where(x => x.Depth == 0 && x.Id != f.Id))
                    {
                        <option value="@i.Id" @(f.ParentId == i.Id ? "selected" : null)>Under &ldquo;@i.Label&rdquo;</option>
                    }
                </select>
                @Html.ValidationMessage("ParentId", null, new { id = "ParentId-error", @class = "admin-field-error" })
            </div>
            <div class="admin-field">
                <label for="SortOrder">Order</label>
                <input type="number" id="SortOrder" name="SortOrder" value="@val("SortOrder", f.SortOrder.ToString())" min="0" max="100000" @ro />
                <p class="admin-hint">Smaller numbers come first.</p>
            </div>
        </div>
        <div class="admin-field">
            <label for="Description">Short description (optional)</label>
            <input type="text" id="Description" name="Description" value="@val("Description", f.Description)" maxlength="160" @ro />
            <p class="admin-hint">Shown under the item in dropdown menus.</p>
        </div>
        <div class="admin-check">
            <input type="checkbox" id="Target" name="Target" value="blank" @(f.Target == "blank" ? "checked" : null) @ro />
            <label for="Target"><strong>Open in a new tab</strong><span class="admin-hint">Use for other websites such as Facebook.</span></label>
        </div>
        <div class="admin-check">
            <input type="checkbox" id="IsVisible" name="IsVisible" value="true" @(f.IsVisible ? "checked" : null) @ro />
            <input type="hidden" name="IsVisible" value="false" />
            <label for="IsVisible"><strong>Show on the website</strong></label>
        </div>
        @if (Model.CanEdit)
        {
            <div><button type="submit" class="admin-button">@(Model.IsNew ? "Add item" : "Save")</button></div>
        }
    </form>
</section>
