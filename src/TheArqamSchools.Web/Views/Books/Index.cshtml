@model PageMeta
@using TheArqamSchools.Web.Helpers
@{
    ViewBag.Meta = Model;
    var error = ViewBag.Error as string;
}
<section class="page-header tone-warm">
    <div class="container">
        <h1 class="h1">Books</h1>
        <p class="lead">Order books from The Arqam Schools. Enter the mobile number registered with our office.</p>
    </div>
</section>
<section class="section tone-white books">
    <div class="container books-narrow">
        <div class="form-card">
            <h2 class="h3">Enter your mobile number</h2>
            @if (error != null && ViewBag.NotRegistered == true)
            {
                <div class="alert alert-error books-contact" role="alert" tabindex="-1" data-focus>
                    <div>
                        <p><strong>This number is not registered for book orders.</strong></p>
                        <p>Please contact the office to register.</p>
                        <p>Phone: <a class="nowrap" href="tel:0412660265">041-2660265</a>, <a class="nowrap" href="tel:0412406479">041-2406479</a></p>
                <p>Mobile/WhatsApp: <a class="nowrap" href="https://wa.me/923392406479" target="_blank" rel="noopener">0339-2406479</a></p>
                    </div>
                </div>
            }
            else if (error != null) { <div class="alert alert-error" role="alert" tabindex="-1" data-focus><p>@error</p></div> }
            <form method="post" action="/books" novalidate>
                @Html.AntiForgeryToken()
                <div class="hp" aria-hidden="true">
                    <label for="bk-website">Website</label>
                    <input id="bk-website" name="website" type="text" tabindex="-1" autocomplete="off" />
                </div>
                <div class="field@(error != null ? " has-error" : "")">
                    <label for="bk-mobile">Mobile number</label>
                    <input id="bk-mobile" name="mobile" type="tel" inputmode="tel" autocomplete="tel" placeholder="0300-1234567" value="@(ViewBag.Mobile as string)" maxlength="20" required />
                </div>
                <button type="submit" class="btn btn-primary btn-block">Continue</button>
            </form>
            <div class="form-note books-help books-contact">
                <p><strong>Not registered yet?</strong> Please contact the office.</p>
                <p>Phone: <a class="nowrap" href="tel:0412660265">041-2660265</a>, <a class="nowrap" href="tel:0412406479">041-2406479</a></p>
                <p>Mobile/WhatsApp: <a class="nowrap" href="https://wa.me/923392406479" target="_blank" rel="noopener">0339-2406479</a></p>
            </div>
        </div>
    </div>
</section>
