@model BookReturn
@using System.Globalization
@using System.Linq
@using TheArqamSchools.Web.Helpers
@using TheArqamSchools.Web.Infrastructure
@{
    Layout = null;
    var inv = CultureInfo.InvariantCulture;
}
<!DOCTYPE html>
<html lang="en-PK">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Return note @Model.ReturnLabel | The Arqam Schools</title>
    <link rel="stylesheet" href="/Content/admin.css?v=20261124a" />
</head>
<body class="invoice-page">
    <div class="invoice-tools">
        <button type="button" class="admin-button" onclick="window.print()">Print</button>
        <a href="/admin/books/customer-accounts/@Model.CustomerId.ToString("D")?view=returns">Back to the customer account</a>
    </div>
    <main class="invoice">
        <header class="invoice-head">
            <div class="invoice-brand">
                <img src="/Content/brand/the-arqam-schools-logo-192.png" alt="The Arqam Schools logo" width="64" height="64" />
                <div>
                    <p class="invoice-name">THE ARQAM SCHOOLS</p>
                    @foreach (var line in BookInvoice.Contact) { <p class="invoice-contact">@line</p> }
                </div>
            </div>
            <div class="invoice-meta">
                <p class="invoice-title">RETURN NOTE</p>
                <p><strong>@Model.ReturnLabel</strong>@if (!string.IsNullOrEmpty(Model.OrderLabels)) { <text> &middot; Orders @Model.OrderLabels</text> }</p>
                <p>Date: @Model.RefundedOn.ToString("d MMMM yyyy", inv)</p>
            </div>
        </header>
        <section class="invoice-parties">
            <div><p class="invoice-label">Customer</p><p><strong>@Model.CustomerName</strong></p><p>Mobile: @Mobile.Format(Model.CustomerMobile)</p></div>
            <div><p class="invoice-label">Received by</p><p>@Model.CreatedByName</p>@if (!string.IsNullOrEmpty(Model.Note)) { <p>@Model.Note</p> }</div>
        </section>
        <table class="invoice-table">
            <thead><tr><th scope="col">Order</th><th scope="col">Class</th><th scope="col">Book</th><th scope="col" class="num">Qty</th><th scope="col" class="num">Price</th><th scope="col" class="num">Total</th></tr></thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr><td>@BookFormat.OrderLabel(l.OrderNo)</td><td>@l.ClassName</td><td>@l.ItemName</td><td class="num">@l.Quantity</td><td class="num">@BookFormat.Money(l.UnitPrice)</td><td class="num">@BookFormat.Money(l.LineTotal)</td></tr>
                }
            </tbody>
        </table>
        <table class="invoice-totals">
            @{ var gross = Model.Lines.Sum(l => l.LineTotal); }
            <tr><th scope="row">Value of books returned</th><td>@BookFormat.Money(gross)</td></tr>
            @if (gross > Model.Amount)
            {
                <tr><th scope="row">Less discount on these books</th><td>&minus; @BookFormat.Money(gross - Model.Amount)</td></tr>
                <tr><th scope="row">Value after discount</th><td>@BookFormat.Money(Model.Amount)</td></tr>
            }
            @if (Model.CreditAmount > 0) { <tr><th scope="row">Added to credit (next order)</th><td>@BookFormat.Money(Model.CreditAmount)</td></tr> }
            <tr class="is-total"><th scope="row">@(Model.RefundPending ? "To be paid back" : "Paid back")</th><td>@BookFormat.Money(Model.RefundAmount)@if (Model.RefundAmount > 0 && !Model.RefundPending) { <text> (@(Model.RefundMethod == "bank" ? "bank" : "cash"))</text> }</td></tr>
        </table>
        <p class="invoice-foot">Signature: ______________________ &nbsp; &nbsp; Customer: ______________________</p>
    </main>
</body>
</html>
