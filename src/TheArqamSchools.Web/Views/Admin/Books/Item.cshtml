@model BookItemEditViewModel
@using System.Globalization
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var f = Model.Form;
    ViewBag.Title = Model.IsNew ? "Add book" : f.Name;
    var ro = Model.CanEdit ? null : "disabled";
    var action = Model.IsNew ? "/admin/books/items/new" : "/admin/books/items/" + f.Id.ToString("D");
    var today = DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(5)).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}
<p><a href="/admin/books/items">&larr; Books &amp; stock</a></p>
<div class="admin-page-head"><h1>@(Model.IsNew ? "Add book" : f.ClassName + " \u2013 " + f.Name)</h1></div>
@if (Model.Notice != null) { <div class="admin-alert admin-alert--success" role="status"><p>@Model.Notice</p></div> }
@Html.Partial("~/Views/Admin/_Errors.cshtml")
<form method="post" action="@action" class="admin-form" novalidate>
    @Html.AntiForgeryToken()
    <section class="admin-card">
        <h2 class="admin-card-title">Item</h2>
        <div class="admin-grid-4">
            <div class="admin-field">
                <label for="Category">Category</label>
                <select id="Category" name="Category" @(Model.CanEdit ? null : "disabled")>
                    <option value="books" @(f.Category != "stationery" ? "selected" : null)>Books</option>
                    <option value="stationery" @(f.Category == "stationery" ? "selected" : null)>Stationery</option>
                </select>
            </div>
            <div class="admin-field">
                <label for="ClassName">Class</label>
                <select id="ClassName" name="ClassName" required aria-describedby="ClassName-error" @(Model.CanEdit ? null : "disabled")>
                    <option value="">Choose the class</option>
                    @foreach (var c in Model.Classes) { <option value="@c" @(c == f.ClassName ? "selected" : null)>@c</option> }
                </select>
                @Html.ValidationMessage("ClassName", null, new { id = "ClassName-error", @class = "admin-field-error" })
            </div>
            <div class="admin-field">
                <label for="Name">Book name</label>
                <input type="text" id="Name" name="Name" value="@f.Name" maxlength="200" required aria-describedby="Name-error" @ro />
                @Html.ValidationMessage("Name", null, new { id = "Name-error", @class = "admin-field-error" })
            </div>
            <div class="admin-field">
                <label for="Vendor">Vendor (optional)</label>
                <input type="text" id="Vendor" name="Vendor" value="@f.Vendor" maxlength="150" aria-describedby="Vendor-hint Vendor-error" @ro />
                <p class="admin-hint" id="Vendor-hint">Who the book is bought from. Never shown to customers.</p>
                @Html.ValidationMessage("Vendor", null, new { id = "Vendor-error", @class = "admin-field-error" })
            </div>
        </div>
        <h2 class="admin-card-title admin-card-title--gap">Prices (Rs.)</h2>
        <div class="admin-grid-4" data-sale-calc>
            <div class="admin-field">
                <label for="PurchasePrice">Purchase price</label>
                <input type="text" inputmode="decimal" id="PurchasePrice" name="PurchasePrice" value="@(Model.IsNew && f.PurchasePrice == 0 ? "" : f.PurchasePrice.ToString("0.##", CultureInfo.InvariantCulture))" aria-describedby="PurchasePrice-hint PurchasePrice-error" @ro />
                <p class="admin-hint" id="PurchasePrice-hint">What we pay the vendor.</p>
                @Html.ValidationMessage("PurchasePrice", null, new { id = "PurchasePrice-error", @class = "admin-field-error" })
            </div>
            <div class="admin-field">
                <label for="RetailPrice">Retail price</label>
                <input type="text" inputmode="decimal" id="RetailPrice" name="RetailPrice" value="@(f.RetailPrice.HasValue ? f.RetailPrice.Value.ToString("0.##", CultureInfo.InvariantCulture) : "")" aria-describedby="RetailPrice-hint RetailPrice-error" @ro />
                <p class="admin-hint" id="RetailPrice-hint">The price printed on the book.</p>
                @Html.ValidationMessage("RetailPrice", null, new { id = "RetailPrice-error", @class = "admin-field-error" })
            </div>
            <div class="admin-field">
                <label for="DiscountPercent">Discount %</label>
                <input type="text" inputmode="decimal" id="DiscountPercent" name="DiscountPercent" value="@(f.DiscountPercent.HasValue ? f.DiscountPercent.Value.ToString("0.##", CultureInfo.InvariantCulture) : "")" aria-describedby="DiscountPercent-hint DiscountPercent-error" @ro />
                <p class="admin-hint" id="DiscountPercent-hint">For example 25 (numbers only).</p>
                @Html.ValidationMessage("DiscountPercent", null, new { id = "DiscountPercent-error", @class = "admin-field-error" })
            </div>
            <div class="admin-field">
                <label for="SalePrice">Sale price</label>
                <input type="text" inputmode="decimal" id="SalePrice" name="SalePrice" value="@(Model.IsNew && f.SalePrice == 0 ? "" : f.SalePrice.ToString("0.##", CultureInfo.InvariantCulture))" aria-describedby="SalePrice-hint SalePrice-error" @(f.RetailPrice.HasValue ? "readonly" : null) @ro />
                <p class="admin-hint" id="SalePrice-hint">What the customer pays: retail price less the discount, worked out for you. Only this price is shown to customers.</p>
                @Html.ValidationMessage("SalePrice", null, new { id = "SalePrice-error", @class = "admin-field-error" })
            </div>
        </div>
        <h2 class="admin-card-title admin-card-title--gap">On the order page</h2>
        <div class="admin-order-row">
            <div class="admin-field admin-field--narrow">
                <label for="SortOrder">Order in the list</label>
                <input type="text" inputmode="numeric" id="SortOrder" name="SortOrder" value="@f.SortOrder" aria-describedby="SortOrder-hint" @ro />
                <p class="admin-hint admin-hint--small" id="SortOrder-hint">Smaller numbers come first within the class.</p>
            </div>
            <div class="admin-check admin-check--stacked">
                <input type="checkbox" id="IsActive" name="IsActive" value="true" aria-describedby="IsActive-hint" @(f.IsActive ? "checked" : null) @ro />
                <input type="hidden" name="IsActive" value="false" />
                <label for="IsActive"><strong>Shown to customers</strong><span class="admin-hint admin-hint--small" id="IsActive-hint">Untick to hide the book from the order page.</span></label>
            </div>
        </div>
        @if (Model.CanEdit) { <div class="admin-form-actions"><button type="submit" class="admin-button">@(Model.IsNew ? "Add book" : "Save changes")</button></div> }
    </section>
</form>
@if (!Model.IsNew)
{
    <section class="admin-card" id="stock" aria-labelledby="stock-h">
        <h2 id="stock-h" class="admin-card-title">Stock: <strong>@Model.Stock</strong> in hand</h2>
        @{ var warnAt = Model.ReorderLevel ?? BookFormat.DefaultReorderLevel; }
        @if (Model.Stock <= warnAt) { <p class="admin-alert admin-alert--warn" role="status">Low stock: @Model.Stock in hand, minimum level @warnAt.</p> }
        @if (Model.CanEdit)
        {
            <form method="post" action="/admin/books/items/@f.Id.ToString("D")/reorder" class="admin-form admin-inline-row admin-reorder" novalidate>
                @Html.AntiForgeryToken()
                <div class="admin-field admin-field--narrow">
                    <label for="level">Minimum stock level</label>
                    <input type="text" inputmode="numeric" id="level" name="level" value="@Model.ReorderLevel" placeholder="@BookFormat.DefaultReorderLevel" aria-describedby="level-hint level-error" />
                    <p class="admin-hint admin-hint--small" id="level-hint">Warn on the Books overview at or below this number. Empty = @BookFormat.DefaultReorderLevel.</p>
                    @Html.ValidationMessage("level", null, new { id = "level-error", @class = "admin-field-error" })
                </div>
                <button type="submit" class="admin-button admin-button--secondary">Save level</button>
            </form>
        }
    </section>
    <section class="admin-card" aria-labelledby="addstock-h">
        <h2 id="addstock-h" class="admin-card-title">Add or correct stock</h2>
        @if (!Model.CanEdit) { <p class="admin-muted">You can view the stock but not change it.</p> }
        @if (Model.CanEdit)
        {
            <form method="post" action="/admin/books/items/@f.Id.ToString("D")/stock" class="admin-form" novalidate>
                @Html.AntiForgeryToken()
                <div class="admin-grid-2">
                    <div class="admin-field">
                        <label for="kind">Type</label>
                        <select id="kind" name="kind">
                            <option value="purchase">Books received (purchase)</option>
                            <option value="correction">Correction (+ or &minus;)</option>
                        </select>
                    </div>
                    <div class="admin-field">
                        <label for="quantity">Number of books</label>
                        <input type="text" inputmode="numeric" id="quantity" name="quantity" aria-describedby="quantity-hint quantity-error" />
                        <p class="admin-hint" id="quantity-hint">For a correction, use a minus sign to take books off, for example -3.</p>
                        @Html.ValidationMessage("quantity", null, new { id = "quantity-error", @class = "admin-field-error" })
                    </div>
                    <div class="admin-field">
                        <label for="date">Date</label>
                        <input type="date" id="date" name="date" value="@today" aria-describedby="date-error" />
                        @Html.ValidationMessage("date", null, new { id = "date-error", @class = "admin-field-error" })
                    </div>
                    <div class="admin-field">
                        <label for="note">Note</label>
                        <input type="text" id="note" name="note" maxlength="500" aria-describedby="note-hint note-error" />
                        <p class="admin-hint" id="note-hint">For example the supplier or bill number. Required for a correction.</p>
                        @Html.ValidationMessage("note", null, new { id = "note-error", @class = "admin-field-error" })
                    </div>
                </div>
                <div class="admin-form-actions"><button type="submit" class="admin-button">Save stock</button></div>
            </form>
        }
    </section>
    <section class="admin-card" aria-labelledby="history-h">
        <h2 id="history-h" class="admin-card-title">Stock history</h2>
        @if (Model.Moves.Count == 0)
        {
            <p class="admin-muted">No stock changes yet.</p>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th scope="col">Date</th><th scope="col">Type</th><th scope="col" class="num">Change</th><th scope="col" class="num">Stock after</th><th scope="col">Order / note</th><th scope="col">By</th></tr></thead>
                    <tbody>
                        @foreach (var m in Model.Moves)
                        {
                            <tr>
                                <td>@m.MovedOn.ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
                                <td>@(char.ToUpperInvariant(m.Kind[0]) + m.Kind.Substring(1))</td>
                                <td class="num">@(m.Change > 0 ? "+" : "")@m.Change</td>
                                <td class="num">@m.StockAfter</td>
                                <td>@if (m.OrderNo.HasValue) { <text>@BookFormat.OrderLabel(m.OrderNo.Value) </text> }@m.Note</td>
                                <td>@m.UserName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
<script src="/Scripts/admin-form.js?v=20261120a" defer></script>
