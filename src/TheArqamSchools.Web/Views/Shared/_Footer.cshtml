@using TheArqamSchools.Web.Data
@using TheArqamSchools.Web.Helpers
@{
    var settings = SiteSettingsRepository.Public();
    var cta = SiteSettingsRepository.Json(settings, "footer.cta") as Newtonsoft.Json.Linq.JObject;
    var mission = SiteSettingsRepository.Text(settings, "footer.mission");
    var tagline = SiteSettingsRepository.Text(settings, "site.tagline");
    var quick = NavigationRepository.Menu("footer");
    var offices = HeadOfficeRepository.Published();
    var holder = SiteSettingsRepository.Text(settings, "legal.copyright_holder", "The Arqam Schools");
    // Social links from the website settings (admin panel > Settings), WhatsApp first.
    var social = Social.Links(settings);
}
<footer class="site-footer">
    @if (cta != null && !(ViewBag.HideFooterCta is bool && (bool)ViewBag.HideFooterCta))
    {
        <div class="footer-cta">
            <div class="container footer-cta-inner">
                <p class="h2">@(cta.Value<string>("heading"))</p>
                <div class="btn-row">
                    @Html.Partial("_Button", cta["primary_cta"], new ViewDataDictionary { { "variant", "primary" } })
                    @Html.Partial("_Button", cta["secondary_cta"], new ViewDataDictionary { { "variant", "outline" } })
                </div>
            </div>
        </div>
    }
    <div class="footer-main">
        <div class="container footer-grid">
            <div class="footer-identity">
                <a class="brand brand-light" href="/" aria-label="The Arqam Schools, home">
                    <img src="~/Content/brand/the-arqam-schools-logo-128.png" srcset="@Url.Content("~/Content/brand/the-arqam-schools-logo-64.png") 64w, @Url.Content("~/Content/brand/the-arqam-schools-logo-128.png") 128w, @Url.Content("~/Content/brand/the-arqam-schools-logo-192.png") 192w" sizes="64px" alt="" width="64" height="64" />
                    <span class="brand-text"><span class="brand-name">The Arqam Schools</span></span>
                </a>
                @* Order (owner, 6 November 2026): logo and name, the Arabic motto, then the footer text; the text
                   breaks after its first sentence pair ("... Education with purpose.") onto a new line. *@
                @if (!string.IsNullOrEmpty(tagline)) { <p class="footer-tagline" lang="@(Site.IsArabic(tagline) ? "ar" : null)" dir="@(Site.IsArabic(tagline) ? "rtl" : null)">@tagline</p> }
                @if (!string.IsNullOrEmpty(mission))
                {
                    var marker = "Education with purpose.";
                    var cut = mission.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
                    var rest = cut >= 0 ? mission.Substring(cut + marker.Length).Trim() : "";
                    if (cut >= 0 && rest.Length > 0)
                    {
                        <p class="footer-statement">@mission.Substring(0, cut + marker.Length)</p>
                        <p class="footer-statement-2">@rest</p>
                    }
                    else
                    {
                        <p class="footer-statement">@mission</p>
                    }
                }
                <ul class="footer-social" aria-label="The Arqam Schools on social media">
                    @foreach (var s in social)
                    {
                        <li><a class="icon-link" href="@s.Url" target="_blank" rel="noopener">@Icons.Svg(s.Icon, 20)<span class="sr-only">@s.Name (opens in a new tab)</span></a></li>
                    }
                </ul>
            </div>
            @foreach (var group in quick)
            {
                <nav class="footer-links" aria-label="@group.Label">
                    <h2>@group.Label</h2>
                    <ul>
                        @foreach (var l in group.Children)
                        {
                            <li><a href="@l.Url">@l.Label</a></li>
                        }
                    </ul>
                </nav>
            }
            @foreach (var o in offices)
            {
                var dash = o.Name.IndexOf(" — ", StringComparison.Ordinal);
                var mapUrl = !string.IsNullOrEmpty(o.GoogleMapsUrl) ? o.GoogleMapsUrl
                    : (string.IsNullOrEmpty(o.Address) ? null : "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(o.Address));
                <address class="footer-office">
                    <h2>
                        @if (dash > 0)
                        {
                            @o.Name.Substring(0, dash + 2)<br />@o.Name.Substring(dash + 3)
                        }
                        else
                        {
                            @o.Name
                        }
                    </h2>
                    @if (!string.IsNullOrEmpty(o.Address))
                    {
                        <p>
                            @if (mapUrl != null)
                            {
                                <a href="@mapUrl" target="_blank" rel="noopener">@o.Address</a>
                            }
                            else
                            {
                                @o.Address
                            }
                        </p>
                    }
                    <ul>
                        @foreach (var p in new[] { o.Phone, o.PhoneAlt })
                        {
                            if (!string.IsNullOrEmpty(p))
                            {
                                <li><a href="@Contact.TelUrl(p)">@Icons.Svg("phone", 16) @p</a></li>
                            }
                        }
                        @if (!string.IsNullOrEmpty(o.Whatsapp))
                        {
                            <li><a href="@Contact.WhatsAppUrl(o.Whatsapp)" target="_blank" rel="noopener">@Icons.Svg("whatsapp", 16) WhatsApp @o.Whatsapp</a></li>
                        }
                        @if (!string.IsNullOrEmpty(o.Email))
                        {
                            <li><a href="mailto:@o.Email">@Icons.Svg("mail", 16) @o.Email</a></li>
                        }
                        @if (mapUrl != null)
                        {
                            <li><a href="@mapUrl" target="_blank" rel="noopener">@Icons.Svg("map-pin", 16) View on Google Maps</a></li>
                        }
                    </ul>
                </address>
            }
        </div>
        <div class="container footer-bottom">
            <p>&copy; @DateTime.Now.Year @holder. All rights reserved.</p>
            <ul class="footer-legal">
                <li><a href="/privacy">Privacy Policy</a></li>
                <li><a href="/terms">Terms of Service</a></li>
                <li><a href="/admin/login" rel="nofollow noopener" target="_blank">Admin<span class="sr-only"> (opens in a new tab)</span></a></li>
            </ul>
        </div>
    </div>
</footer>
