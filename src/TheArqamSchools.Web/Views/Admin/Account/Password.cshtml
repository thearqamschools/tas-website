@model AdminChangePasswordForm
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewBag.Title = "Change password";
}
<section class="admin-card admin-card--narrow">
    <h1>Change password</h1>
    @if (Model.Saved)
    {
        <div class="admin-alert admin-alert--success" role="status"><p>Your password was changed. You have been signed out on every other device.</p></div>
    }
    @Html.Partial("~/Views/Admin/_Errors.cshtml")
    <form method="post" action="/admin/account/password" class="admin-form" novalidate>
        @Html.AntiForgeryToken()
        <div class="admin-field">
            <label for="CurrentPassword">Current password</label>
            @Html.PasswordFor(m => m.CurrentPassword, new { autocomplete = "current-password", required = "required", aria_describedby = "CurrentPassword-error" })
            @Html.ValidationMessageFor(m => m.CurrentPassword, null, new { id = "CurrentPassword-error", @class = "admin-field-error" })
        </div>
        <div class="admin-field">
            <label for="NewPassword">New password</label>
            @Html.PasswordFor(m => m.NewPassword, new { autocomplete = "new-password", required = "required", minlength = "12", maxlength = "128", aria_describedby = "NewPassword-hint NewPassword-error" })
            <p class="admin-hint" id="NewPassword-hint">At least 12 characters. A short sentence you can remember works well.</p>
            @Html.ValidationMessageFor(m => m.NewPassword, null, new { id = "NewPassword-error", @class = "admin-field-error" })
        </div>
        <div class="admin-field">
            <label for="ConfirmPassword">New password again</label>
            @Html.PasswordFor(m => m.ConfirmPassword, new { autocomplete = "new-password", required = "required", aria_describedby = "ConfirmPassword-error" })
            @Html.ValidationMessageFor(m => m.ConfirmPassword, null, new { id = "ConfirmPassword-error", @class = "admin-field-error" })
        </div>
        <button type="submit" class="admin-button">Change password</button>
    </form>
</section>
