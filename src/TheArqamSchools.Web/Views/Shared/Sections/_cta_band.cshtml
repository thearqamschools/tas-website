@model PageSection
@{
    var d = Model.Data;
    var tone = Model.Tone("warm");
}
<section class="cta-band tone-@tone" @(Model.Anchor != null ? "id=" + Model.Anchor : "") aria-labelledby="h-@Model.Id">
    <div class="container cta-inner">
        <div>
            <h2 class="h2" id="h-@Model.Id">@Model.Text("heading")</h2>
            @if (!string.IsNullOrEmpty(Model.Text("body"))) { <p class="lead">@Model.Text("body")</p> }
        </div>
        <div class="btn-row">
            @Html.Partial("_Button", d["primary_cta"], new ViewDataDictionary { { "variant", tone == "navy" ? "light" : "primary" } })
            @Html.Partial("_Button", d["secondary_cta"], new ViewDataDictionary { { "variant", tone == "navy" ? "outline-light" : "outline" } })
        </div>
    </div>
</section>
