@model PageSection
@using TheArqamSchools.Web.Data
@using TheArqamSchools.Web.Helpers
@{
    var page = (PageViewModel)ViewData["page"];
    var vm = page.Contact;
    var f = vm.Form ?? new ContactForm();
    var errors = page.FormErrors;
    Func<string, string> err = key => errors != null && errors.ContainsKey(key) && errors[key].Errors.Count > 0 ? errors[key].Errors[0].ErrorMessage : null;
    var hasErrors = errors != null && !errors.IsValid;
    var settings = SiteSettingsRepository.Public();
    var phone = SiteSettingsRepository.Text(settings, "contact.phone");
    var phoneAlt = SiteSettingsRepository.Text(settings, "contact.phone_alt");
    var whatsapp = SiteSettingsRepository.Text(settings, "contact.whatsapp");
    var address = SiteSettingsRepository.Text(settings, "contact.address");
    var offices = HeadOfficeRepository.Published();
    var types = new Dictionary<string, string> { { "general", "General question" }, { "feedback", "Feedback or suggestion" }, { "careers", "Jobs and careers" }, { "media", "Media" }, { "other", "Something else" } };
}
<section class="section tone-@Model.Tone("white")" id="@(Model.Anchor ?? "contact")" aria-labelledby="h-@Model.Id">
    <div class="container form-layout contact-layout">
        <div class="contact-info">
            <h2 class="h3">Contact Information</h2>
            @if (offices.Count == 0)
            {
                <ul class="contact-list">
                    @if (!string.IsNullOrEmpty(phone)) { <li>@Icons.Svg("phone", 20) <span><a href="@Contact.TelUrl(phone)">@phone</a>@if (!string.IsNullOrEmpty(phoneAlt)) {<text>, <a href="@Contact.TelUrl(phoneAlt)">@phoneAlt</a></text>}</span></li> }
                    @if (!string.IsNullOrEmpty(whatsapp)) { <li>@Icons.Svg("whatsapp", 20) <a href="@Contact.WhatsAppUrl(whatsapp)" target="_blank" rel="noopener">WhatsApp @whatsapp</a></li> }
                    @if (!string.IsNullOrEmpty(address)) { <li>@Icons.Svg("map-pin", 20) <span class="pre-line">@address</span></li> }
                </ul>
            }
            @foreach (var o in offices)
            {
                var dash = o.Name.IndexOf(" — ", StringComparison.Ordinal);
                var officeName = dash > 0 ? o.Name.Substring(dash + 3) : o.Name;
                var phones = new[] { o.Phone, o.PhoneAlt }.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
                var mapLink = !string.IsNullOrEmpty(o.GoogleMapsUrl) && o.GoogleMapsUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ? o.GoogleMapsUrl
                    : (string.IsNullOrEmpty(o.Address) ? null : "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(o.Address));
                <div class="office-card">
                    <h3 class="h4">@officeName</h3>
                    <address>
                    <ul class="office-rows">
                        @if (!string.IsNullOrEmpty(o.Address))
                        {
                            <li><span class="office-icon">@Icons.Svg("map-pin", 20)</span><span><span class="office-label">Address</span>@o.Address</span></li>
                        }
                        @if (phones.Count > 0)
                        {
                            <li><span class="office-icon">@Icons.Svg("phone", 20)</span><span><span class="office-label">Phone</span>@for (var i = 0; i < phones.Count; i++) { if (i > 0) { <text>, </text> } <a href="@Contact.TelUrl(phones[i])">@phones[i]</a> }</span></li>
                        }
                        @if (!string.IsNullOrEmpty(o.Whatsapp))
                        {
                            <li><span class="office-icon">@Icons.Svg("whatsapp", 20)</span><span><span class="office-label">Mobile / WhatsApp</span><a href="@Contact.WhatsAppUrl(o.Whatsapp)" target="_blank" rel="noopener">@o.Whatsapp</a></span></li>
                        }
                        @if (!string.IsNullOrEmpty(o.Email))
                        {
                            <li><span class="office-icon">@Icons.Svg("mail", 20)</span><span><span class="office-label">Email</span><a href="mailto:@o.Email">@o.Email</a></span></li>
                        }
                        @if (!string.IsNullOrEmpty(o.Hours))
                        {
                            <li><span class="office-icon">@Icons.Svg("clock", 20)</span><span><span class="office-label">Office Hours</span><span class="pre-line">@o.Hours</span></span></li>
                        }
                    </ul>
                    </address>
                    @if (!string.IsNullOrEmpty(o.Address))
                    {
                        <div class="office-map">
                            <iframe title="Map: @officeName" src="https://maps.google.com/maps?q=@Uri.EscapeDataString("The Arqam Schools, " + o.Address)&amp;z=16&amp;output=embed" loading="lazy"></iframe>
                        </div>
                    }
                    @if (mapLink != null) { <p><a class="text-link" href="@mapLink" target="_blank" rel="noopener">Open in Google Maps @Icons.Svg("external", 16)</a></p> }
                </div>
            }
            <p class="muted">For admissions, please use the <a href="/admissions#inquiry">admission inquiry form</a> or contact your nearest campus on the <a href="/campuses">Campuses page</a>.</p>
        </div>
        <div class="form-card">
            <h2 class="h3" id="h-@Model.Id">@(string.IsNullOrEmpty(Model.Text("heading")) ? "Send Us a Message" : Model.Text("heading"))</h2>
            @if (!string.IsNullOrEmpty(Model.Text("intro"))) { <p class="form-card-intro">@SimpleFormat.Render(Model.Text("intro"))</p> }
            @if (vm.Sent)
            {
                <div class="alert alert-success" role="status" tabindex="-1" data-focus>
                    @Icons.Svg("check-circle", 22)
                    <p>@(string.IsNullOrEmpty(Model.Text("success")) ? "Thank you. Your message has been received and we will reply soon." : Model.Text("success"))</p>
                </div>
                <p><a class="text-link" href="/contact#contact">Send another message</a></p>
            }
            else
            {
                if (vm.RateLimited)
                {
                    <div class="alert alert-error" role="alert" tabindex="-1" data-focus><p>You have sent several messages in a short time. Please wait a few minutes and try again, or call us.</p></div>
                }
                else if (hasErrors)
                {
                    <div class="alert alert-error" role="alert" tabindex="-1" data-focus><p>Please check the highlighted fields and try again.</p></div>
                }
                <p class="form-note">Fields marked <span class="req">*</span> are required. Please give a phone number or an email address.</p>
                <form method="post" action="/contact/send#contact" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="hp" aria-hidden="true">
                        <label for="ct-website">Website</label>
                        <input id="ct-website" name="Website" type="text" tabindex="-1" autocomplete="off" />
                    </div>
                    <div class="field@(err("Type") != null ? " has-error" : "")">
                        <label for="ct-type">What is your message about? <span class="req" aria-hidden="true">*</span></label>
                        <select id="ct-type" name="Type" @(err("Type") != null ? "aria-invalid=true aria-describedby=ct-type-err" : "")>
                            @foreach (var t in types) { <option value="@t.Key" @(f.Type == t.Key ? "selected" : "")>@t.Value</option> }
                        </select>
                        @if (err("Type") != null) { <p class="field-error" id="ct-type-err">@err("Type")</p> }
                    </div>
                    <div class="field@(err("Name") != null ? " has-error" : "")">
                        <label for="ct-name">Your name <span class="req" aria-hidden="true">*</span></label>
                        <input id="ct-name" name="Name" type="text" value="@f.Name" maxlength="120" autocomplete="name" required @(err("Name") != null ? "aria-invalid=true aria-describedby=ct-name-err" : "") />
                        @if (err("Name") != null) { <p class="field-error" id="ct-name-err">@err("Name")</p> }
                    </div>
                    <div class="field-row">
                        <div class="field@(err("Phone") != null ? " has-error" : "")">
                            <label for="ct-phone">Phone or WhatsApp</label>
                            <input id="ct-phone" name="Phone" type="tel" inputmode="tel" value="@f.Phone" maxlength="20" autocomplete="tel" placeholder="0300-1234567" @(err("Phone") != null ? "aria-invalid=true aria-describedby=ct-phone-err" : "") />
                            @if (err("Phone") != null) { <p class="field-error" id="ct-phone-err">@err("Phone")</p> }
                        </div>
                        <div class="field@(err("Email") != null ? " has-error" : "")">
                            <label for="ct-email">Email</label>
                            <input id="ct-email" name="Email" type="email" inputmode="email" value="@f.Email" maxlength="254" autocomplete="email" @(err("Email") != null ? "aria-invalid=true aria-describedby=ct-email-err" : "") />
                            @if (err("Email") != null) { <p class="field-error" id="ct-email-err">@err("Email")</p> }
                        </div>
                    </div>
                    <div class="field@(err("Subject") != null ? " has-error" : "")">
                        <label for="ct-subject">Subject <span class="optional">(optional)</span></label>
                        <input id="ct-subject" name="Subject" type="text" value="@f.Subject" maxlength="200" @(err("Subject") != null ? "aria-invalid=true aria-describedby=ct-subject-err" : "") />
                        @if (err("Subject") != null) { <p class="field-error" id="ct-subject-err">@err("Subject")</p> }
                    </div>
                    <div class="field@(err("Message") != null ? " has-error" : "")">
                        <label for="ct-message">Message <span class="req" aria-hidden="true">*</span></label>
                        <textarea id="ct-message" name="Message" rows="5" maxlength="3000" required @(err("Message") != null ? "aria-invalid=true aria-describedby=ct-message-err" : "")>@f.Message</textarea>
                        @if (err("Message") != null) { <p class="field-error" id="ct-message-err">@err("Message")</p> }
                    </div>
                    <div class="field field-check@(err("Consent") != null ? " has-error" : "")">
                        <label><input type="checkbox" name="Consent" value="true" @(f.Consent ? "checked" : "") required @(err("Consent") != null ? "aria-invalid=true aria-describedby=ct-consent-err" : "") /> <span>I agree that The Arqam Schools may contact me about this message. <span class="req" aria-hidden="true">*</span></span></label>
                        @if (err("Consent") != null) { <p class="field-error" id="ct-consent-err">@err("Consent")</p> }
                    </div>
                    <button type="submit" class="btn btn-primary">Send message</button>
                </form>
            }
        </div>
    </div>
</section>
