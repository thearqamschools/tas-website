@model PageSection
@using TheArqamSchools.Web.Helpers
@{
    var page = (PageViewModel)ViewData["page"];
    var vm = page.Directory;
    var action = vm.FormAction ?? "/campuses";
    var cityLocked = vm.FormAction != null;
}
<section class="section tone-@Model.Tone("white")" id="@(Model.Anchor ?? "find")" aria-labelledby="h-@Model.Id">
    <div class="container">
        <div class="section-head">
            <h2 class="h2" id="h-@Model.Id">@Model.Text("heading")</h2>
        </div>
        <form class="finder" method="get" action="@(action)#find" role="search" aria-label="Find a campus">
            <div class="field finder-q">
                <label for="cf-q">Campus name, area or address</label>
                <div class="input-icon">
                    @Icons.Svg("search", 20)
                    <input id="cf-q" name="q" type="search" value="@vm.Query" maxlength="100" placeholder="For example, Samanabad" />
                </div>
            </div>
            @if (!cityLocked)
            {
                <div class="field">
                    <label for="cf-city">City</label>
                    <select id="cf-city" name="city">
                        <option value="">All cities</option>
                        @foreach (var c in vm.Cities)
                        {
                            <option value="@c.Slug" @(vm.City == c.Slug ? "selected" : "")>@c.Name (@c.Count)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="cf-district">District</label>
                    <select id="cf-district" name="district">
                        <option value="">All districts</option>
                        @foreach (var c in vm.Districts)
                        {
                            <option value="@c.Slug" @(vm.District == c.Slug ? "selected" : "")>@c.Name (@c.Count)</option>
                        }
                    </select>
                </div>
            }
            <div class="finder-actions">
                <button type="submit" class="btn btn-primary">Search</button>
                @if (vm.IsFiltered && !cityLocked)
                {
                    <a class="text-link" href="/campuses#find">Clear</a>
                }
                else if (cityLocked)
                {
                    <a class="text-link" href="/campuses#find">All campuses</a>
                }
            </div>
        </form>
        <p class="results-count" role="status">
            @if (vm.Results.Count == 1) { <text>1 campus</text> } else { <text>@vm.Results.Count campuses</text> }
            @(vm.IsFiltered ? " match your search" : " listed")
        </p>
        @if (vm.Results.Count == 0)
        {
            <div class="empty-state"><p>@Model.Text("empty")</p><p><a class="btn btn-outline" href="/contact">Contact the head office</a></p></div>
        }
        else
        {
            <ul class="campus-grid">
                @foreach (var c in vm.Results)
                {
                    <li>
                        <article class="campus-card" id="campus-@c.Id">
                            <div class="campus-card-head">
                                <h3 class="h4"><a href="@c.Url">@c.Name</a></h3>
                                <p class="campus-locality">@Icons.Svg("map-pin", 16) @c.Locality</p>
                                <span class="badge badge-@(c.AdmissionStatus ?? "contact_campus")">@c.AdmissionLabel</span>
                            </div>
                            <dl class="campus-facts">
                                @if (!string.IsNullOrWhiteSpace(c.AddressLine))
                                {
                                    <div><dt>Address</dt><dd>@c.FullAddress</dd></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(c.Phone))
                                {
                                    <div><dt>Phone</dt><dd><a href="@Contact.TelUrl(c.Phone)">@c.Phone</a>@if (!string.IsNullOrWhiteSpace(c.PhoneAlt)) {<text>, </text><a href="@Contact.TelUrl(c.PhoneAlt)">@c.PhoneAlt</a>}</dd></div>
                                }
                                @if (c.Status == "coming_soon")
                                {
                                    <div><dt>Status</dt><dd>Opening soon</dd></div>
                                }
                            </dl>
                            <div class="campus-actions">
                                <a class="btn btn-primary btn-sm" href="@c.Url">View details<span class="sr-only">: @c.Name</span></a>
                                @if (!string.IsNullOrWhiteSpace(c.Phone))
                                {
                                    <a class="btn btn-outline btn-sm" href="@Contact.TelUrl(c.Phone)">@Icons.Svg("phone", 16) Call</a>
                                }
                                @if (!string.IsNullOrWhiteSpace(c.Whatsapp))
                                {
                                    <a class="btn btn-outline btn-sm" href="@Contact.WhatsAppUrl(c.Whatsapp)" target="_blank" rel="noopener">@Icons.Svg("whatsapp", 16) WhatsApp<span class="sr-only"> (opens in a new tab)</span></a>
                                }
                            </div>
                        </article>
                    </li>
                }
            </ul>
        }
        @if (!string.IsNullOrEmpty(Model.Text("note")))
        {
            <p class="muted section-foot">@Model.Text("note")</p>
        }
    </div>
</section>
