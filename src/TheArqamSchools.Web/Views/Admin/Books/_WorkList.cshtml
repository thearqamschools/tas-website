@model IList<BookOrder>
@using TheArqamSchools.Web.Helpers
@* A list of orders on the Today page, each with its next step as one button (30 November 2026).
   ViewData: Id, Title, Empty, Act (pack, handover, confirm), CanOrders. *@
@{
    var id = (string)ViewData["Id"];
    var act = (string)ViewData["Act"];
    var canOrders = (bool)ViewData["CanOrders"];
    var pk = TimeSpan.FromHours(5);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<section class="admin-card" id="@id" aria-labelledby="@id-h">
    <h2 id="@id-h">@ViewData["Title"] <span class="admin-count admin-count--blue">@Model.Count</span></h2>
    @if (Model.Count == 0) { <p class="admin-muted">@ViewData["Empty"]</p> }
    <ul class="admin-work">
        @foreach (var o in Model)
        {
            var status = act == "pack" ? "packed" : act == "confirm" ? "checked" : (o.Fulfilment == "delivery" ? "delivered" : "collected");
            var label = act == "pack" ? "Mark packed" : act == "confirm" ? "Confirm order" : (o.Fulfilment == "delivery" ? "Mark delivered" : "Mark collected");
            <li>
                <a class="admin-work-main" href="/admin/books/orders/@o.OrderNo"><strong>@o.OrderLabel &middot; @o.CustomerName</strong>
                    <span>@o.BookCount books &middot; @(o.Fulfilment == "delivery" ? "Delivery" : "Pick up") &middot; @(o.Balance > 0 ? "to pay " + BookFormat.Money(o.Balance) : "paid") &middot; @o.CreatedAt.ToOffset(pk).ToString("d MMM", inv)</span></a>
                @if (canOrders)
                {
                    <form method="post" action="/admin/books/orders/@o.OrderNo/status">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="status" value="@status" />
                        <input type="hidden" name="back" value="home" />
                        <button type="submit" class="admin-button">@label</button>
                    </form>
                }
            </li>
        }
    </ul>
</section>
