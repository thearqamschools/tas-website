@using TheArqamSchools.Web.Models
@{
    var adminUser = ViewBag.AdminUser as AdminPrincipal;
    var title = ViewBag.Title as string;
}
<!DOCTYPE html>
<html lang="en-PK">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>@(string.IsNullOrEmpty(title) ? "Admin" : title) | The Arqam Schools Admin</title>
    <link rel="stylesheet" href="/Content/admin.css?v=20261110a" />
</head>
<body class="admin">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="admin-header">
        <a class="admin-brand" href="/admin">
            <img src="/Content/brand/the-arqam-schools-logo-official.png" alt="The Arqam Schools" width="40" height="40" />
            <span>Admin panel</span>
        </a>
        @if (adminUser != null)
        {
            <nav class="admin-nav" aria-label="Admin">
                <a href="/admin">Dashboard</a>
                @if (adminUser.Can("inquiries.view"))
                {
                    <a href="/admin/inquiries">Inquiries</a>
                    <a href="/admin/messages">Messages</a>
                }
                @if (adminUser.Can("franchise.view"))
                {
                    <a href="/admin/franchise">Franchise</a>
                }
                @if (adminUser.Can("news.view") || adminUser.Can("events.view"))
                {
                    <a href="/admin/news">News</a>
                }
                @if (adminUser.Can("pages.view"))
                {
                    <a href="/admin/pages">Pages</a>
                }
                @if (adminUser.Can("branches.view"))
                {
                    <a href="/admin/campuses">Campuses</a>
                }
                @if (adminUser.Can("navigation.view"))
                {
                    <a href="/admin/menus">Menus</a>
                }
                @if (adminUser.Can("settings.view"))
                {
                    <a href="/admin/settings">Settings</a>
                }
                @if (adminUser.Can("users.manage"))
                {
                    <a href="/admin/users">Users</a>
                }
                <a href="/admin/account/password">Change password</a>
                <form method="post" action="/admin/logout" class="admin-signout">
                    @Html.AntiForgeryToken()
                    <button type="submit">Sign out</button>
                </form>
            </nav>
        }
    </header>
    <main id="main" class="admin-main" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="admin-footer">
        <a href="/" target="_blank" rel="noopener">View website</a>
    </footer>
</body>
</html>
