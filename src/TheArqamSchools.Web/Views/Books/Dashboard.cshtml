@using TheArqamSchools.Web.Helpers
@{
    var customer = ViewBag.Customer as BookCustomer;
    var s = ViewBag.Summary as TheArqamSchools.Web.Data.BookCustomerAccountRepository.Summary;
    var orders = ViewBag.Orders as IList<BookOrder>;
    var pk = TimeSpan.FromHours(5);
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var stillToPay = Math.Max(0m, s.Balance);
}
<section class="page-header tone-warm">
    <div class="container">
        <h1 class="h1">Assalamualaikum, @customer.Name</h1>
        <p class="lead">Your book orders, payments and balance with The Arqam Schools.</p>
    </div>
</section>
<section class="section tone-white books">
    <div class="container books-wide">
        @Html.Partial("~/Views/Books/_Who.cshtml", customer)
        <div class="books-stats">
            <div class="books-stat@(stillToPay > 0 ? " is-due" : " is-ok")"><p class="books-stat-value">@BookFormat.Money(stillToPay)</p><p class="books-stat-label">Still to pay</p></div>
            <div class="books-stat"><p class="books-stat-value">@s.Orders</p><p class="books-stat-label">Orders (@s.Completed completed, @s.Open open@(s.Cancelled > 0 ? ", " + s.Cancelled + " cancelled" : ""))</p></div>
            <div class="books-stat"><p class="books-stat-value">@BookFormat.Money(s.OrderTotal)</p><p class="books-stat-label">Value of your orders</p></div>
            <div class="books-stat"><p class="books-stat-value">@BookFormat.Money(s.Paid)</p><p class="books-stat-label">You have paid</p></div>
            @if (s.Returned > 0) { <div class="books-stat"><p class="books-stat-value">@BookFormat.Money(s.Returned)</p><p class="books-stat-label">Books returned (@s.BooksReturned)</p></div> }
            @if (s.Credit > 0) { <div class="books-stat is-ok"><p class="books-stat-value">@BookFormat.Money(s.Credit)</p><p class="books-stat-label">Your credit (used on the next order)</p></div> }
            @if (s.RefundPending > 0) { <div class="books-stat"><p class="books-stat-value">@BookFormat.Money(s.RefundPending)</p><p class="books-stat-label">To be paid back to you</p></div> }
        </div>
        <div class="books-card">
            <h2 class="h3">Recent orders</h2>
            @if (orders.Count == 0) { <p>No orders yet.</p> }
            else
            {
                <ul class="books-history">
                    @foreach (var o in orders)
                    {
                        <li class="books-card books-history-item">
                            <div class="books-history-head">
                                <a class="books-order-link books-card-link" href="/books/orders/@o.OrderNo">@o.OrderLabel</a>
                                <span class="books-status books-status-@o.Status">@o.CustomerStatusLabel</span>
                            </div>
                            <p class="books-history-meta">@o.CreatedAt.ToOffset(pk).ToString("d MMMM yyyy", inv) &middot; @o.Lines.Sum(l => l.Quantity) books &middot; <strong>@BookFormat.Money(o.CustomerTotal)</strong>@if (o.Status != "cancelled" && o.Balance > 0) { <text> &middot; to pay @BookFormat.Money(o.Balance)</text> }</p>
                        </li>
                    }
                </ul>
                <p><a href="/books/orders">All my orders</a></p>
            }
        </div>
    </div>
</section>
