<?xml version="1.0" encoding="utf-8"?>
<!--
  SSL certificate checks (Let's Encrypt HTTP validation): the host puts an extensionless
  file in /.well-known/acme-challenge/ and the certificate service reads it over plain http.
  This folder is served as static files only: no MVC routing, no HTTPS redirect.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension="." />
      <mimeMap fileExtension="." mimeType="text/plain" />
    </staticContent>
    <handlers>
      <clear />
      <add name="StaticFile" path="*" verb="GET,HEAD" modules="StaticFileModule" resourceType="Either" requireAccess="Read" />
    </handlers>
  </system.webServer>
</configuration>
