<?xml version="1.0" encoding="utf-8"?>
<!-- Applied when publishing in Release mode. Set the real connection string on the server, not here. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="Site:Url" value="https://thearqamschools.com" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <!-- Testing phase: keep the live site out of search engines. Change to false on launch day. -->
    <add key="Site:NoIndex" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="On" xdt:Transform="SetAttributes(mode)" />
  </system.web>
</configuration>
