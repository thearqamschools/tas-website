@model IList<BookAccount>
@* How the customer paid (notes 59 and 61): the school's bank accounts with a Copy button, or Cash; then the receipt,
   from the camera ("Take photo") or a file. No amount is typed: the office enters what the receipt shows.
   ViewData "Id" keeps the ids unique on the page. *@
@{
    var id = (ViewData["Id"] as string) ?? "pay";
    var accounts = Model ?? new List<BookAccount>();
}
<fieldset class="books-pay-choice">
    <legend class="sr-only">How did you pay?</legend>
    @for (var i = 0; i < accounts.Count; i++)
    {
        var a = accounts[i];
        <label class="books-pay-opt">
            <input type="radio" name="pay" value="@a.Id.ToString("D")" required @(i == 0 ? "checked" : null) data-pay-bank />
            <span class="books-pay-body">
                <span class="books-pay-name">@a.Name</span>
                @if (!string.IsNullOrEmpty(a.AccountNumber)) { <span class="books-pay-acc" id="@id-acc-@i">@a.AccountNumber</span> }
                @if (!string.IsNullOrEmpty(a.AccountTitle)) { <span class="books-pay-sub">@a.AccountTitle</span> }
                @if (!string.IsNullOrEmpty(a.Iban)) { <span class="books-pay-sub">IBAN @a.Iban</span> }
            </span>
            @if (!string.IsNullOrEmpty(a.AccountNumber)) { <button type="button" class="books-copy" data-copy-text="@a.AccountNumber" aria-label="Copy the @a.Name account number">Copy</button> }
        </label>
    }
    <label class="books-pay-opt">
        <input type="radio" name="pay" value="cash" required @(accounts.Count == 0 ? "checked" : null) />
        <span class="books-pay-body"><span class="books-pay-name">Cash</span><span class="books-pay-sub">Pay at the office, or when the books are delivered</span></span>
    </label>
</fieldset>
<div class="books-receipt" data-receipt>
    <p class="books-receipt-label">Receipt <span>(for a bank payment)</span></p>
    <div class="books-receipt-btns">
        <label class="books-receipt-btn" for="@id-photo">@TheArqamSchools.Web.Helpers.Icons.Svg("eye", 20) Take photo</label>
        <input type="file" id="@id-photo" name="PayPhoto" accept="image/*" capture="environment" class="books-file" data-receipt-input />
        <label class="books-receipt-btn" for="@id-file">Choose file</label>
        <input type="file" id="@id-file" name="PayReceipt" accept="image/jpeg,image/png,application/pdf" class="books-file" data-receipt-input />
    </div>
    <p class="books-receipt-name" data-receipt-name aria-live="polite"></p>
    <p class="form-note">A photo (JPG or PNG) or a PDF, up to 10 MB.</p>
</div>
