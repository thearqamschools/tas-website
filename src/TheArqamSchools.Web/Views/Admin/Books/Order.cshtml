@model BookOrderAdminViewModel
@using System.Globalization
@using TheArqamSchools.Web.Helpers
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var o = Model.Order;
    ViewBag.Title = "Order " + o.OrderLabel;
    var pk = TimeSpan.FromHours(5);
    var inv = CultureInfo.InvariantCulture;
    var pf = Model.PaymentForm;
    var next = new List<KeyValuePair<string, string>>();
    if (o.Status == "new") { next.Add(new KeyValuePair<string, string>("checked", "Confirm order")); }
    if (o.Status == "new" || o.Status == "checked") { next.Add(new KeyValuePair<string, string>("packed", "Mark as packed")); }
    if (o.Status != "cancelled" && o.Status != "delivered" && o.Status != "collected")
    {
        next.Add(o.Fulfilment == "delivery" ? new KeyValuePair<string, string>("delivered", "Mark as delivered") : new KeyValuePair<string, string>("collected", "Mark as collected"));
        if (o.PaidTotal == 0 && o.DiscountTotal == 0) { next.Add(new KeyValuePair<string, string>("cancelled", "Cancel order")); }
    }
    // Owner's request (30 November 2026): one big "next step" button; the other actions under More.
    var primary = next.FirstOrDefault(n => n.Key != "cancelled");
    var others = next.Where(n => n.Key != "cancelled" && n.Key != primary.Key).ToList();
    var canCancel = next.Any(n => n.Key == "cancelled");
    var done = o.Status == "delivered" || o.Status == "collected";
    var steps = new[]
    {
        new { Text = "Placed", Done = true },
        new { Text = "Confirmed", Done = o.Status != "new" },
        new { Text = "Packed", Done = o.Status == "packed" || done },
        new { Text = o.Fulfilment == "delivery" ? "Delivered" : "Collected", Done = done }
    };
    var current = steps.Select((x, i) => new { x, i }).Where(t => !t.x.Done).Select(t => t.i).DefaultIfEmpty(-1).First();
}
<p class="admin-back"><a href="/admin/books/orders">&larr; Orders</a></p>
<div class="admin-page-head admin-order-top">
    <div class="admin-order-head">
        <h1>@o.OrderLabel</h1>
        <span class="admin-status admin-status--@(o.Status == "new" ? "new" : o.Status == "cancelled" ? "spam" : done ? "closed" : "in_progress")">@BookFormat.StatusLabel(o.Status)</span>
        <span class="admin-status">@o.PaymentStatus</span>
        @if (o.Status != "cancelled" && o.Balance > 0) { <span class="admin-tag admin-tag--warn">@BookFormat.Money(o.Balance) to pay</span> }
    </div>
    <div class="admin-order-actions">
        @if (Model.CanOrders && primary.Key != null)
        {
            <form method="post" action="/admin/books/orders/@o.OrderNo/status">
                @Html.AntiForgeryToken()
                <input type="hidden" name="status" value="@primary.Key" />
                <button type="submit" class="admin-button">@primary.Value &rarr;</button>
            </form>
        }
        @if (Model.CanPay && o.Status != "cancelled" && o.Balance > 0) { <a class="admin-button admin-button--secondary" href="#payment">+ Payment</a> }
        <details class="admin-more">
            <summary class="admin-button admin-button--secondary">More &#9662;</summary>
            <div class="admin-more-menu">
                <a href="/admin/books/orders/@o.OrderNo/invoice" target="_blank" rel="noopener">Print invoice</a>
                <a href="/admin/books/orders/@o.OrderNo/invoice-pdf">Download PDF</a>
                @if (Model.CanOrders)
                {
                    foreach (var n in others)
                    {
                        <form method="post" action="/admin/books/orders/@o.OrderNo/status">@Html.AntiForgeryToken()<input type="hidden" name="status" value="@n.Key" /><button type="submit">@n.Value</button></form>
                    }
                    if (o.OfficeCanEdit) { <a href="/admin/books/orders/@o.OrderNo/edit">Change books</a> }
                }
                <a href="/admin/books/customer-accounts/@o.CustomerId.ToString("D")/return">Record a return</a>
                <a href="/admin/books/customer-accounts/@o.CustomerId.ToString("D")">Customer account</a>
                @if (Model.CanOrders && canCancel)
                {
                    <form method="post" action="/admin/books/orders/@o.OrderNo/status">@Html.AntiForgeryToken()<input type="hidden" name="status" value="cancelled" /><button type="submit" class="is-danger" data-confirm="Cancel order @o.OrderLabel?">Cancel order</button></form>
                }
                @if (Model.CanRemove)
                {
                    <form method="post" action="/admin/books/orders/@o.OrderNo/remove">@Html.AntiForgeryToken()<button type="submit" class="is-danger" data-confirm="Remove cancelled order @o.OrderLabel? It will be hidden everywhere (kept in the database).">Remove this order</button></form>
                }
            </div>
        </details>
    </div>
</div>
@if (Model.Notice != null) { <div class="admin-alert admin-alert--success" role="status"><p>@Model.Notice</p></div> }
@if (Model.Error != null) { <div class="admin-alert admin-alert--error" role="alert"><p>@Model.Error</p></div> }

@if (o.Status != "cancelled")
{
    <ol class="admin-track" aria-label="Order progress">
        @for (var i = 0; i < steps.Length; i++) { <li class="@(steps[i].Done ? "is-done" : i == current ? "is-current" : null)">@steps[i].Text</li> }
    </ol>
}
<div class="admin-order-grid">
<div class="admin-order-main">
<section class="admin-card">
    <h2>Books</h2>
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead><tr><th scope="col">Class</th><th scope="col">Book</th><th scope="col" class="num">Qty</th><th scope="col" class="num">Price</th><th scope="col" class="num">Total</th></tr></thead>
            <tbody>
                @foreach (var l in o.Lines)
                {
                    <tr><td>@l.ClassName</td><td>@l.ItemName</td><td class="num">@l.Quantity@if (l.ReturnedQty > 0) { <span class="admin-tag">@l.ReturnedQty returned</span> }</td><td class="num">@BookFormat.Money(l.UnitPrice)</td><td class="num">@BookFormat.Money(l.LineTotal)</td></tr>
                }
            </tbody>
        </table>
    </div>
    <table class="admin-money">
        <tr><th scope="row">Total</th><td>@BookFormat.Money(o.Subtotal)</td></tr>
        @if (o.ReturnedTotal > 0) { <tr><th scope="row">Returned</th><td>− @BookFormat.Money(o.ReturnedTotal)</td></tr> }
        @if (o.DiscountTotal > 0) { <tr><th scope="row">Discount</th><td>− @BookFormat.Money(o.DiscountTotal)</td></tr> }
        @if (o.CreditApplied > 0) { <tr><th scope="row">Customer credit</th><td>− @BookFormat.Money(o.CreditApplied)</td></tr> }
        <tr><th scope="row">Paid</th><td>− @BookFormat.Money(o.PaidTotal)</td></tr>
        @if (o.RefundedTotal > 0) { <tr><th scope="row">Returned to the customer (credit or refund)</th><td>+ @BookFormat.Money(o.RefundedTotal)</td></tr> }
        <tr class="is-total"><th scope="row">Balance</th><td>@BookFormat.Money(o.Balance)</td></tr>
    </table>
</section>

<section class="admin-card" id="payments">
    <h2>Payments</h2>
    @if (Model.Payments.Count == 0)
    {
        <p class="admin-muted">No payments yet.</p>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th scope="col">Date</th><th scope="col" class="num">Amount</th><th scope="col" class="num">Discount</th><th scope="col">Method / account</th><th scope="col">Received by</th><th scope="col">Receipt</th><th scope="col">Note</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        <tr>
                            <td>@p.ReceivedOn.ToString("d MMM yyyy", inv)</td>
                            <td class="num">@BookFormat.Money(p.Amount)</td>
                            <td class="num">@(p.Discount > 0 ? BookFormat.Money(p.Discount) : "")</td>
                            <td>@(p.Method == null ? "" : (p.Method == "bank" ? "Bank" : "Cash") + " · " + p.AccountName)</td>
                            <td>@p.ReceivedByName</td>
                            <td>@if (p.ReceiptPath != null && Model.CanPay) { <a href="/admin/books/payments/@p.Id.ToString("D")/receipt" target="_blank" rel="noopener">View</a> }</td>
                            <td>@p.Note</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (Model.CanPay && o.Status != "cancelled" && o.Balance > 0)
    {
        <h3 class="admin-subhead" id="payment">Record a payment</h3>
        if (o.PendingPayments > 0) { <p class="admin-alert admin-alert--warn" role="status">The customer has sent a payment (see "Payments sent by the customer" above). Please confirm or reject it before recording another payment.</p> }
        if (Model.Accounts.Count == 0)
        {
            <p>Please add a cash or bank account first under <a href="/admin/books/accounts">Accounts</a>.</p>
        }
        else
        {
            if (!o.StockTakenAt.HasValue) { <p class="admin-hint">This is the first payment: the order's books will be taken off stock when you save it.</p> }
            <form method="post" action="/admin/books/orders/@o.OrderNo/payments" class="admin-form" enctype="multipart/form-data" novalidate>
                @Html.AntiForgeryToken()
                <div class="admin-grid-2">
                    <div class="admin-field">
                        <label for="Amount">Amount received (Rs.)</label>
                        <input type="text" inputmode="decimal" id="Amount" name="Amount" value="@(pf.Amount > 0 ? pf.Amount.ToString("0.##", inv) : "")" placeholder="Balance @o.Balance.ToString("0.##", inv)" />
                        <p class="admin-hint">Part payments are allowed.</p>
                    </div>
                    <div class="admin-field">
                        <label for="Discount">Discount (Rs., optional)</label>
                        <input type="text" inputmode="decimal" id="Discount" name="Discount" value="@(pf.Discount > 0 ? pf.Discount.ToString("0.##", inv) : "")" />
                        <p class="admin-hint">Reduces the balance. Never shown to the customer.</p>
                    </div>
                    <div class="admin-field">
                        <label for="Method">Method</label>
                        <select id="Method" name="Method" data-account-filter>
                            <option value="cash" @(pf.Method != "bank" ? "selected" : null)>Cash</option>
                            <option value="bank" @(pf.Method == "bank" ? "selected" : null)>Bank transfer</option>
                        </select>
                    </div>
                    <div class="admin-field">
                        <label for="AccountId">Account</label>
                        <select id="AccountId" name="AccountId">
                            <option value="">Choose…</option>
                            @foreach (var a in Model.Accounts) { <option value="@a.Id.ToString("D")" data-kind="@a.Kind" @(pf.AccountId == a.Id ? "selected" : null)>@(a.Kind == "bank" ? "Bank" : "Cash"): @a.Name</option> }
                        </select>
                    </div>
                    <div class="admin-field">
                        <label for="ReceivedOn">Date</label>
                        <input type="date" id="ReceivedOn" name="ReceivedOn" value="@pf.ReceivedOn.ToString("yyyy-MM-dd", inv)" />
                    </div>
                    <div class="admin-field">
                        <label>Received by</label>
                        <p class="admin-readonly">@ViewBag.AdminUser.DisplayName (you)</p>
                    </div>
                    <div class="admin-field">
                        <label for="Receipt">Receipt (photo or PDF, optional for cash)</label>
                        <input type="file" id="Receipt" name="Receipt" accept="image/jpeg,image/png,application/pdf" />
                    </div>
                    <div class="admin-field">
                        <label for="Note">Note (optional)</label>
                        <input type="text" id="Note" name="Note" value="@pf.Note" maxlength="500" />
                    </div>
                </div>
                <div><button type="submit" class="admin-button">Save payment</button></div>
            </form>
        }
    }
</section>

<section class="admin-card" id="returns">
    <h2>Returns</h2>
    @if (Model.Returns.Count == 0) { <p class="admin-muted">No books returned.</p> }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th scope="col">Return</th><th scope="col">Date</th><th scope="col">Books</th><th scope="col" class="num">Value</th><th scope="col" class="num">Paid back</th><th scope="col">By</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.Returns)
                    {
                        <tr>
                            <td><a href="/admin/books/returns/@r.ReturnNo" target="_blank" rel="noopener">@r.ReturnLabel</a></td>
                            <td>@r.RefundedOn.ToString("d MMM yyyy", inv)</td>
                            <td>@string.Join(", ", r.Lines.Select(l => l.Quantity + " × " + l.ItemName))</td>
                            <td class="num">@BookFormat.Money(r.Amount)</td>
                            <td class="num">@(r.RefundAmount > 0 ? BookFormat.Money(r.RefundAmount) + " (" + (r.RefundMethod == "bank" ? "bank" : "cash") + ")" : "–")</td>
                            <td>@r.CreatedByName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <p class="admin-hint">Returns are recorded per customer, because the books may come from several orders: <a href="/admin/books/customer-accounts/@o.CustomerId.ToString("D")/return">Record a return for @o.CustomerName</a>.</p>
</section>

</div>
<aside class="admin-order-side">
    <section class="admin-card">
        <h2>Customer</h2>
        <dl class="admin-details admin-details--tight">
            <dt>Name</dt><dd><a href="/admin/books/customer-accounts/@o.CustomerId.ToString("D")">@o.CustomerName</a></dd>
            <dt>Mobile</dt><dd>@Mobile.Format(o.CustomerMobile) &middot; <a href="@Contact.WhatsAppUrl(o.CustomerMobile)" target="_blank" rel="noopener">WhatsApp</a></dd>
            @if (!string.IsNullOrEmpty(o.CampusName)) { <dt>Campus</dt><dd>@o.CampusName</dd> }
            <dt>Gets books</dt><dd>@(o.Fulfilment == "delivery" ? "Delivery: " + o.DeliveryAddress : "Pick up from the office")</dd>
            <dt>Placed</dt><dd>@o.CreatedAt.ToOffset(pk).ToString("d MMM yyyy, h:mm tt", inv) &middot; @(o.Source == "office" ? "by the office" : "on the website")</dd>
            <dt>Stock</dt><dd>@(o.StockTakenAt.HasValue ? "Taken off on " + o.StockTakenAt.Value.ToOffset(pk).ToString("d MMM yyyy", inv) : "Not taken yet (at the first payment)")</dd>
        </dl>
    </section>
@if (Model.Submissions != null && Model.Submissions.Count > 0)
{
    <section class="admin-card" id="sent" aria-labelledby="sent-h">
        <h2 id="sent-h">Payments sent by the customer</h2>
        <p class="admin-muted">Open the receipt and check that the money has arrived in the account. Confirm records the payment (and takes the books off stock at the first payment) and confirms the order.</p>
        @foreach (var sp in Model.Submissions)
        {
            @Html.Partial("~/Views/Admin/Books/_SentPayment.cshtml", sp, new ViewDataDictionary { { "CanPay", Model.CanPay }, { "Back", "order" } })
        }
    </section>
}
@if (o.Edits != null && o.Edits.Count > 0)
{
    <section class="admin-card">
        <h2>Changes to this order</h2>
        <ul class="admin-edit-list">
            @foreach (var e in o.Edits)
            {
                <li>
                    <strong>@e.CreatedAt.ToOffset(pk).ToString("d MMM yyyy, h:mm tt", inv)</strong> · @(e.ByCustomer ? "by the customer" : "by " + (e.UserName ?? "the office")) · total @BookFormat.Money(e.OldSubtotal) → @BookFormat.Money(e.NewSubtotal)
                    <ul>@foreach (var c in EditLines(e.Changes)) { <li>@c</li> }</ul>
                </li>
            }
        </ul>
    </section>
}
</aside>
</div>
<script src="/Scripts/admin-form.js?v=20261120c" defer></script>
@functions {
    static IEnumerable<string> EditLines(string json)
    {
        var list = new List<string>();
        try
        {
            foreach (var t in Newtonsoft.Json.Linq.JArray.Parse(json))
            {
                if (t["book"] != null) list.Add((string)t["book"] + ": " + (int)t["from"] + " → " + (int)t["to"]);
                else if (t["cancelled"] != null) list.Add("Order cancelled by the customer");
                else if (t["fulfilment"] != null) list.Add("Pick up / delivery: " + (string)t["fulfilment"]["from"] + " → " + (string)t["fulfilment"]["to"]);
            }
        }
        catch (Newtonsoft.Json.JsonException) { list.Add("(details not readable)"); }
        return list;
    }
}
