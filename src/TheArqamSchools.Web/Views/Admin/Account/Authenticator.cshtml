@model AdminEnrollViewModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewBag.Title = "Set up two-step verification";
}
<section class="admin-card admin-card--narrow">
    <h1>Set up two-step verification</h1>
    <p>Every admin account needs a 6-digit code from an authenticator app as well as the password. This takes about a minute and is done once.</p>
    <ol class="admin-steps">
        <li>Install <strong>Google Authenticator</strong> or <strong>Microsoft Authenticator</strong> on your phone.</li>
        <li>
            On your phone, tap <a href="@Model.SetupUri">add this account to the app</a>.
            Or, in the app, choose <em>Enter a setup key</em> and type:
            <dl class="admin-setup-key">
                <dt>Account</dt><dd>@Model.Email</dd>
                <dt>Key</dt><dd><code>@Model.SecretGrouped</code></dd>
                <dt>Type</dt><dd>Time based</dd>
            </dl>
        </li>
        <li>Enter the 6-digit code the app now shows for <strong>The Arqam Schools</strong>.</li>
    </ol>
    @Html.Partial("~/Views/Admin/_Errors.cshtml")
    <form method="post" action="/admin/login/authenticator" class="admin-form" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="@Model.Form.ReturnUrl" />
        <div class="admin-field">
            <label for="Code">6-digit code</label>
            <input type="text" id="Code" name="Code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]*" maxlength="7" required class="admin-code-input" aria-describedby="Code-error" />
            @Html.ValidationMessage("Code", null, new { id = "Code-error", @class = "admin-field-error" })
        </div>
        <button type="submit" class="admin-button">Confirm and sign in</button>
    </form>
    <p class="admin-note">Keep this key private. If you lose your phone, a Super Admin will need to reset your two-step verification. This page expires after 10 minutes; <a href="/admin/login">start again</a> if it does.</p>
</section>
